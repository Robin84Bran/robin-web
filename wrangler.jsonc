{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "robin-web",
  "compatibility_date": "2026-08-20",
  "main": "./public/_worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
