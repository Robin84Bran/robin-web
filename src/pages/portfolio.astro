---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageLead from '../components/PageLead.astro';
import GravityField from '../components/GravityField.astro';
import { createPortfolioSchemas } from '../lib/seo';
---

<BaseLayout
  title="Portfolio — Robin Xie"
  description="A visual field of the institutions, frontiers, capital, and systems that shape Robin Xie's attention."
  path="/portfolio/"
  schema={createPortfolioSchemas()}
>
  <PageLead eyebrow="Portfolio / attention field" title="Capital follows attention." line="biography → topology" />
  <div class="shell portfolio-canvas">
    <GravityField />
  </div>
</BaseLayout>
