---
import BaseLayout from '../layouts/BaseLayout.astro';
import { identityCore } from '../data/identityCore';
import { createPersonSchema, createWebsiteSchema, createBreadcrumbSchema, absoluteUrl } from '../lib/seo';
const person=createPersonSchema();
const description='I AM ROBIN. Four illustrated phases: subsea engineering, FinTech, entrepreneurship, and transformation. Enter my story.';
const schema=[person,createWebsiteSchema(),{'@context':'https://schema.org','@type':'ProfilePage','@id':absoluteUrl('/identity/#profile'),url:absoluteUrl('/identity/'),name:'I AM ROBIN — Identity',description,mainEntity:{'@id':person['@id']},author:{'@id':person['@id']},inLanguage:'en',relatedLink:[absoluteUrl('/about/')]},createBreadcrumbSchema([{name:'Home',path:'/'},{name:'Identity',path:'/identity/'}])];
const phases=identityCore.chapters;
---
<BaseLayout title="I AM ROBIN — Identity" {description} path="/identity/" {schema}>
 <article class="identity-motion" aria-labelledby="identity-title">
  <header><p class="motion-eyebrow">I · Identity</p><h1 id="identity-title">I AM ROBIN.</h1><p class="motion-name">Robin Xie · 谢玢 · 謝玢</p></header>
  <div class="phase-layout">
   <div class="phase-side"><p>Entrepreneur<br/>Investor<br/>Engineer</p><a href="/about/#roots-story">13½ · My story ↗</a></div>
   <div class="phase-art" aria-hidden="true">
    {phases.map((_,i)=><div class:list={['phase-picture', {'is-active':i===0}]} style={`--position:${i%2 ? '100%' : '0%'} ${i>1 ? '100%' : '0%'}`} data-art={i}></div>)}
   </div>
   <div class="phase-counter" aria-hidden="true"><span id="phase-number">01</span><span>/ 04</span></div>
  </div>
  <div class="phase-caption">
   {phases.map((p,i)=><a class:list={['phase-story',{'is-active':i===0}]} href={`/about/#${p.id}`} data-story={i} hidden={i!==0}><span>{p.label}</span><small>Read this part of my story ↗</small></a>)}
  </div>
  <nav class="phase-controls" aria-label="Choose an identity phase">
   {phases.map((p,i)=><button type="button" data-select={i} aria-pressed={i===0} disabled><span>{String(i+1).padStart(2,'0')}</span>{p.label}</button>)}
  </nav>
  <button type="button" class="phase-play" hidden>Pause motion</button>
  <nav class="identity-doors" aria-label="Eight-door sequence"><a href="/network/">← Network</a><a href="/about/">About me</a><a href="/asymmetry/">Asymmetry →</a></nav>
 </article>
</BaseLayout>
<style>
.identity-motion { width: min(88%,72rem); margin: auto; padding: 2.8rem 0 1rem; }
.identity-motion header { text-align: center; }
.motion-eyebrow { color: var(--gold-dark); font: .65rem var(--sans); letter-spacing: .2em; text-transform: uppercase; }
.identity-motion h1 { font: 400 clamp(3rem,6.5vw,6rem)/1.1 var(--serif); letter-spacing: -.035em; margin: 1rem 0 .8rem; }
.motion-name { font: .95rem var(--serif); color: var(--muted); letter-spacing: .08em; }
.phase-layout { display: grid; grid-template-columns: 1fr minmax(0,34rem) 1fr; align-items: center; gap: 1rem; }
.phase-side { padding-left: 1rem; border-left: 1px solid var(--gold); }
.phase-side p { font: .67rem/2.2 var(--sans); letter-spacing: .15em; text-transform: uppercase; }
.phase-side a { display: inline-block; margin-top: 2rem; color: var(--gold-dark); font: .85rem var(--serif); text-underline-offset: .3em; }
.phase-art { position: relative; aspect-ratio: 1; min-width: 0; isolation: isolate; }
.phase-picture { position: absolute; inset: 0; background-image: url('/identity/core/phase-atlas.webp'); background-size: 200% 200%; background-position: var(--position); opacity: 0; transform: scale(.94) rotate(-2deg); transition: opacity 2.1s ease, transform 7s ease; mix-blend-mode: multiply; }
.phase-picture.is-active { opacity: 1; transform: scale(1) rotate(0); }
.phase-counter { display: grid; justify-content: center; gap: .7rem; color: var(--gold-dark); font: .85rem var(--serif); }
#phase-number { font-size: 2rem; }
.phase-caption { text-align: center; min-height: 5rem; }
.phase-story { color: var(--ink); text-decoration: none; }
.phase-story span { display: block; font: 400 clamp(1.6rem,3vw,2.4rem) var(--serif); }
.phase-story small { display: block; font: .72rem var(--sans); color: var(--gold-dark); margin-top: .75rem; }
.phase-controls { display: flex; gap: 1.5rem; justify-content: center; margin-top: 1.5rem; }
.phase-controls button { border: 0; border-bottom: 1px solid transparent; background: transparent; color: var(--muted); font: .8rem/1.5 var(--serif); min-height: 44px; padding: .5rem .3rem; cursor: pointer; }
.phase-controls button span { display: block; font: .6rem var(--sans); margin-bottom: .5rem; color: var(--gold-dark); }
.phase-controls button[aria-pressed=true] { color: var(--ink); font-weight: 700; border-color: var(--gold); }
.phase-play { display: block; background: transparent; border: 0; margin: 1rem auto; color: var(--muted); font: .65rem var(--sans); min-height: 44px; cursor: pointer; }
.phase-play[hidden], .phase-story[hidden] { display:none; }
.identity-doors { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; border-top: 1px solid var(--line); padding: 1.5rem 0; margin-top: 2rem; }
.identity-doors a { font: .75rem var(--sans); color: var(--gold-dark); text-decoration: none; }
.identity-motion a:focus-visible, .identity-motion button:focus-visible { outline: 2px solid var(--gold-dark); outline-offset: 5px; }
@media(max-width:650px) {
 .identity-motion { width: calc(100% - 2rem); padding-top: 1.6rem; }
 .identity-motion h1 { font-size: 3.15rem; }
 .phase-layout { display: block; position: relative; }
 .phase-side { border: 0; padding: 0; text-align: center; }
 .phase-side p { display:none; }
 .phase-side a { margin-top: .5rem; font-size: .78rem; }
 .phase-art { width: 100%; margin: .5rem auto; }
 .phase-counter { display: none; }
 .phase-controls { gap: .4rem; display:grid; grid-template-columns: repeat(2,minmax(0,1fr)); margin-top:.5rem; }
 .phase-controls button { font-size: .7rem; overflow-wrap: anywhere; }
 .phase-caption { min-height: 4rem; }
 .phase-story span { font-size: 1.75rem; }
 .identity-doors { margin-top: 1rem; }
}
@media(prefers-reduced-motion:reduce) { .phase-picture { transition: none; transform: none; } }
</style>
<script>
const root=document.querySelector<HTMLElement>('.identity-motion');
if(root){
 const controls=[...root.querySelectorAll<HTMLButtonElement>('[data-select]')];
 const art=[...root.querySelectorAll<HTMLElement>('[data-art]')];
 const stories=[...root.querySelectorAll<HTMLAnchorElement>('[data-story]')];
 const toggle=root.querySelector<HTMLButtonElement>('.phase-play')!;
 const count=root.querySelector<HTMLElement>('#phase-number')!;
 const reduce=matchMedia('(prefers-reduced-motion: reduce)');
 let index=0,playing=!reduce.matches,visible=true,timer:ReturnType<typeof setInterval>|undefined;
 function show(next:number){index=next;art.forEach((el,i)=>el.classList.toggle('is-active',i===index));stories.forEach((el,i)=>{el.hidden=i!==index;});controls.forEach((el,i)=>el.setAttribute('aria-pressed',String(i===index)));count.textContent=String(index+1).padStart(2,'0');}
 function sync(){clearInterval(timer);if(playing&&visible&&!document.hidden)timer=setInterval(()=>show((index+1)%4),8500);toggle.textContent=playing?'Pause motion':'Play motion';}
 controls.forEach((el,i)=>{el.disabled=false;el.addEventListener('click',()=>{playing=false;show(i);sync();});});
 toggle.hidden=false;toggle.addEventListener('click',()=>{playing=!playing;sync();});
 // Pause while keyboard focus is inside the rotating story link.
 root.querySelector('.phase-caption')?.addEventListener('focusin',()=>{playing=false;sync();});
 document.addEventListener('visibilitychange',sync);
 reduce.addEventListener('change',()=>{if(reduce.matches)playing=false;sync();});
 new IntersectionObserver(([entry])=>{visible=entry.isIntersecting;sync();}).observe(root);
 sync();
}
</script>
