---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import OuroborosPublication from '../../../../components/OuroborosPublication.astro';
import { createDiarySchemas } from '../../../../lib/seo';

export async function getStaticPaths() {
  const entries = await getCollection('diary', ({ data }) => !data.draft);
  return entries.map((entry) => {
    const date = entry.data.date.toISOString().slice(0, 10).replaceAll('-', '');
    return {
      params: { yearMonth: date.slice(0, 6), entrySlug: entry.id.split('/')[0] },
      props: { entry },
    };
  });
}

interface Props { entry: CollectionEntry<'diary'>; }
const { entry } = Astro.props;
const { Content } = await render(entry);
const publicationDate = entry.data.date.toISOString().slice(0, 10);
const compactDate = publicationDate.replaceAll('-', '');
const path = `/meaning/diary/${compactDate.slice(0, 6)}/${entry.id.split('/')[0]}/`;
const displayDate = entry.data.date.toLocaleDateString('en-US', {
  timeZone: 'UTC', month: 'long', day: 'numeric', year: 'numeric',
});
const schemas = createDiarySchemas({
  title: entry.data.title,
  description: entry.data.excerpt,
  path,
  image: entry.data.ogImage,
  datePublished: publicationDate,
  dateModified: entry.data.updated.toISOString().slice(0, 10),
  inLanguage: entry.data.inLanguage,
});
---

<OuroborosPublication
  kind="diary" title={entry.data.title} description={entry.data.excerpt} {path}
  image={entry.data.ogImage} imageAlt={`Diary illustration for ${entry.data.title}`}
  hero={entry.data.hero} heroAlt={`A pale shoujo manga interpretation of ${entry.data.title}`}
  {publicationDate} {displayDate} schema={schemas} language={entry.data.inLanguage}
  alternates={[{ hreflang: entry.data.inLanguage, path }, { hreflang: 'x-default', path }]}
  languageLinks={[]}
  crumbs={[{ label: 'Meaning', href: '/meaning/' }, { label: 'Diary' }]}
  intro="A moment, kept in its own words."
  footerText="Original text preserved. No translation."
  footerLink="/meaning/#diary" footerLinkLabel="Return to Diary →"
>
  <Content />
</OuroborosPublication>
