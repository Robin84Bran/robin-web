---
import { getCollection, type CollectionEntry } from 'astro:content';
import DiaryEdition from '../../../../components/DiaryEdition.astro';

export async function getStaticPaths() {
  const entries = await getCollection('diary', ({ data }) => !data.draft && (!data.originalLanguage || data.inLanguage === data.originalLanguage));
  return entries.map((entry) => {
    const date = entry.data.date.toISOString().slice(0, 10).replaceAll('-', '');
    return {
      params: { yearMonth: date.slice(0, 6), entrySlug: entry.id.split('/')[0] },
      props: { entry },
    };
  });
}

interface Props { entry: CollectionEntry<'diary'>; }
const { entry } = Astro.props;
---
<DiaryEdition {entry} />
