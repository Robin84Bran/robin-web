---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import OuroborosPublication from '../../../../../components/OuroborosPublication.astro';
import { createArticleSchemas } from '../../../../../lib/seo';

export async function getStaticPaths() {
  const entries = await getCollection('actionItemTranslation', ({ data }) => !data.draft);
  return entries.map((entry) => {
    const date = entry.data.date.toISOString().slice(0, 10).replaceAll('-', '');
    return { params: { yearMonth: date.slice(0, 6), date, lang: entry.data.languageSlug }, props: { entry } };
  });
}

interface Props { entry: CollectionEntry<'actionItemTranslation'>; }
const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const publicationDate = entry.data.date.toISOString().slice(0, 10);
const compactDate = publicationDate.replaceAll('-', '');
const briefingPath = `/ouroboros/${compactDate.slice(0, 6)}/${compactDate}/`;
const basePath = `${briefingPath}action_item/`;
const path = `${basePath}${entry.data.languageSlug}/`;
const languages = [
  { hreflang: 'en', label: 'English', path: basePath },
  { hreflang: 'zh-Hans', label: '简体中文', path: `${basePath}zh-hans/` },
  { hreflang: 'zh-Hant', label: '繁體中文', path: `${basePath}zh-hant/` },
  { hreflang: 'ja', label: '日本語', path: `${basePath}ja/` },
];
const localeMap = { 'zh-Hans': 'zh-CN', 'zh-Hant': 'zh-TW', ja: 'ja-JP' } as const;
const schemas = createArticleSchemas({
  title: entry.data.title, description: entry.data.excerpt, path, image: entry.data.ogImage,
  datePublished: publicationDate, dateModified: entry.data.updated.toISOString().slice(0, 10),
  keywords: entry.data.keywords, inLanguage: entry.data.inLanguage,
});
const displayDate = entry.data.date.toLocaleDateString(localeMap[entry.data.inLanguage], { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' });
const localized = entry.data.inLanguage === 'ja'
  ? { intro: 'スコアボードを備えた商流。', footer: 'シグナルから台帳へ。台帳から記憶へ。', back: '本日の8つのシグナルへ戻る →' }
  : entry.data.inLanguage === 'zh-Hant'
    ? { intro: '一個帶著記分板的商業循環。', footer: '從訊號到台帳。從台帳到記憶。', back: '返回今日八個訊號 →' }
    : { intro: '一个带着记分板的商业循环。', footer: '从信号到台账。从台账到记忆。', back: '返回今日八个信号 →' };
---

<OuroborosPublication
  kind="action" title={entry.data.title} description={entry.data.excerpt} {path}
  image={entry.data.ogImage} imageAlt={`Google and Marvell AI circularity flow diagram for ${displayDate}`}
  hero={entry.data.hero} heroAlt="Google purchase demand, Marvell revenue, and warrant vesting arranged as a circular flow"
  {publicationDate} {displayDate} schema={schemas} language={entry.data.inLanguage} alternates={languages}
  languageLinks={languages.filter((item) => item.hreflang !== entry.data.inLanguage)}
  crumbs={[{ label: 'Ouroboros', href: '/identity/ouroboros/' }, { label: 'Daily Briefing', href: `${briefingPath}${entry.data.languageSlug}/` }, { label: 'Action Item' }]}
  indexLabel="01 · AI Circularity Ledger" intro={localized.intro}
  footerText={localized.footer} footerLink={`${briefingPath}${entry.data.languageSlug}/`} footerLinkLabel={localized.back}
>
  <Content />
</OuroborosPublication>
