---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import OuroborosPublication from '../../../../../components/OuroborosPublication.astro';
import { createArticleSchemas } from '../../../../../lib/seo';

const slugs = { en: '', 'zh-Hans': 'zh-hans', 'zh-Hant': 'zh-hant', ja: 'ja' } as const;
export async function getStaticPaths() {
  const entries = await getCollection('dailySpecial', ({ data }) => !data.draft);
  const languages = { en: undefined, 'zh-Hans': 'zh-hans', 'zh-Hant': 'zh-hant', ja: 'ja' };
  return entries.map((entry) => {
    const date = entry.data.date.toISOString().slice(0, 10).replaceAll('-', '');
    return { params: { yearMonth: date.slice(0, 6), date, language: languages[entry.data.inLanguage] }, props: { entry } };
  });
}
interface Props { entry: CollectionEntry<'dailySpecial'>; }
const { entry } = Astro.props;
const { Content } = await render(entry);
const publicationDate = entry.data.date.toISOString().slice(0, 10);
const date = publicationDate.replaceAll('-', '');
const base = `/ouroboros/${date.slice(0, 6)}/${date}/special/`;
const locale = entry.data.inLanguage;
const path = slugs[locale] ? `${base}${slugs[locale]}/` : base;
const labels = { en: 'English', 'zh-Hans': '简体中文', 'zh-Hant': '繁體中文', ja: '日本語' };
const languages = (Object.keys(slugs) as Array<keyof typeof slugs>).map((key) => ({ hreflang: key, label: labels[key], path: slugs[key] ? `${base}${slugs[key]}/` : base }));
const schemas = createArticleSchemas({title: entry.data.title, description: entry.data.excerpt, path, image: entry.data.ogImage,
  datePublished: publicationDate, dateModified: entry.data.updated.toISOString().slice(0, 10), keywords: entry.data.keywords, inLanguage: locale });
---
<OuroborosPublication kind="action" title={entry.data.title} description={entry.data.excerpt} {path}
  image={entry.data.ogImage} imageAlt={entry.data.title} hero={entry.data.hero} heroAlt={entry.data.title}
  {publicationDate} displayDate={publicationDate} schema={schemas} language={locale} alternates={languages}
  languageLinks={languages.filter((item) => item.hreflang !== locale)}
  crumbs={[{label: 'Ouroboros', href: '/ouroboros/'}, {label: 'Daily Special'}]}
  indexLabel={`03 · Daily Special · Signal ${entry.data.sourceSignal}`} intro={entry.data.researchScope}
  footerText="Research artifact only. Decisions remain with Robin." footerLink="/ouroboros/#daily-special" footerLinkLabel="Daily Special →">
  <Content />
  <p><a href={`/daily-special/${date}/artifact.md`}>Research artifact · Markdown</a></p>
</OuroborosPublication>
