---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import OuroborosPublication from '../../../../components/OuroborosPublication.astro';
import { createArticleSchemas } from '../../../../lib/seo';

export async function getStaticPaths() {
  const entries = await getCollection('dailyBriefingTranslation', ({ data }) => !data.draft);
  const actionItems = await getCollection('actionItem', ({ data }) => !data.draft);
  return entries.map((entry) => {
    const date = entry.data.date.toISOString().slice(0, 10).replaceAll('-', '');
    return {
      params: { yearMonth: date.slice(0, 6), date, lang: entry.data.languageSlug },
      props: { entry, hasActionItem: actionItems.some((item) => item.data.date.toISOString().slice(0, 10).replaceAll('-', '') === date) },
    };
  });
}

interface Props { entry: CollectionEntry<'dailyBriefingTranslation'>; hasActionItem: boolean; }
const { entry, hasActionItem } = Astro.props as Props;
const { Content } = await render(entry);
const publicationDate = entry.data.date.toISOString().slice(0, 10);
const compactDate = publicationDate.replaceAll('-', '');
const basePath = `/ouroboros/${compactDate.slice(0, 6)}/${compactDate}/`;
const path = `${basePath}${entry.data.languageSlug}/`;
const languages = [
  { hreflang: 'en', label: 'English', path: basePath },
  { hreflang: 'zh-Hans', label: '简体中文', path: `${basePath}zh-hans/` },
  { hreflang: 'zh-Hant', label: '繁體中文', path: `${basePath}zh-hant/` },
  { hreflang: 'ja', label: '日本語', path: `${basePath}ja/` },
];
const localeMap = { 'zh-Hans': 'zh-CN', 'zh-Hant': 'zh-TW', ja: 'ja-JP' } as const;
const schemas = createArticleSchemas({
  title: entry.data.title, description: entry.data.excerpt, path, image: entry.data.ogImage,
  datePublished: publicationDate, dateModified: entry.data.updated.toISOString().slice(0, 10),
  keywords: entry.data.keywords, inLanguage: entry.data.inLanguage,
});
const displayDate = entry.data.date.toLocaleDateString(localeMap[entry.data.inLanguage], { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' });
const localized = entry.data.inLanguage === 'ja'
  ? { intro: '8つのシグナル。4つの言語。ひとつの動く場。', footer: '観察し、解釈し、再びループへ。', action: '本日のアクションアイテムを読む →' }
  : entry.data.inLanguage === 'zh-Hant'
    ? { intro: '八個訊號。四種語言。一個流動的場。', footer: '觀察。解讀。回到循環。', action: '閱讀今日行動項目 →' }
    : { intro: '八个信号。四种语言。一个流动的场。', footer: '观察。解读。回到循环。', action: '阅读今日行动项目 →' };
---

<OuroborosPublication
  kind="briefing" title={entry.data.title} description={entry.data.excerpt} {path}
  image={entry.data.ogImage} imageAlt={`Ouroboros signal field for ${displayDate}`}
  hero={entry.data.hero} heroAlt={`Abstract orbital field for ${displayDate}`}
  {publicationDate} {displayDate} schema={schemas} language={entry.data.inLanguage} alternates={languages}
  languageLinks={languages.filter((item) => item.hreflang !== entry.data.inLanguage)}
  crumbs={[{ label: 'Ouroboros', href: '/ouroboros/' }, { label: 'Daily Briefing' }]}
  intro={localized.intro} footerText={localized.footer}
  footerLink={hasActionItem ? `${basePath}action_item/${entry.data.languageSlug}/` : undefined}
  footerLinkLabel={hasActionItem ? localized.action : undefined}
>
  <Content />
</OuroborosPublication>
