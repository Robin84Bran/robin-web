---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import OuroborosPublication from '../../../../components/OuroborosPublication.astro';
import { createArticleSchemas } from '../../../../lib/seo';

export async function getStaticPaths() {
  const entries = await getCollection('blog', ({ data }) => !data.draft);
  return entries.map((entry) => {
    const date = entry.data.date.toISOString().slice(0, 10).replaceAll('-', '');
    return { params: { yearMonth: date.slice(0, 6), date }, props: { entry } };
  });
}

interface Props { entry: CollectionEntry<'blog'>; }
const { entry } = Astro.props;
const { Content } = await render(entry);
const publicationDate = entry.data.date.toISOString().slice(0, 10);
const compactDate = publicationDate.replaceAll('-', '');
const briefingPath = `/ouroboros/${compactDate.slice(0, 6)}/${compactDate}/`;
const path = `${briefingPath}blog/`;
const languages = [
  { hreflang: 'en', label: 'English', path },
  { hreflang: 'zh-Hans', label: '简体中文', path: `${path}zh-hans/` },
  { hreflang: 'zh-Hant', label: '繁體中文', path: `${path}zh-hant/` },
  { hreflang: 'ja', label: '日本語', path: `${path}ja/` },
];
const schemas = createArticleSchemas({
  title: entry.data.title, description: entry.data.excerpt, path, image: entry.data.ogImage,
  datePublished: publicationDate, dateModified: entry.data.updated.toISOString().slice(0, 10),
  keywords: entry.data.keywords, inLanguage: entry.data.inLanguage,
});
const displayDate = entry.data.date.toLocaleDateString('en-US', { timeZone: 'UTC', month: 'long', day: 'numeric', year: 'numeric' });
---

<OuroborosPublication
  kind="blog" title={entry.data.title} description={entry.data.excerpt} {path}
  image={entry.data.ogImage} imageAlt={`Ouroboros ${entry.data.lane} essay for ${displayDate}`}
  hero={entry.data.hero} heroAlt={`Editorial image for ${entry.data.title}`}
  {publicationDate} {displayDate} schema={schemas} language="en" alternates={languages}
  languageLinks={languages.filter((item) => item.hreflang !== 'en')}
  crumbs={[{ label: 'Ouroboros', href: '/ouroboros/' }, { label: 'Blog' }, { label: entry.data.lane }]}
  indexLabel={`${entry.data.lane} · M / W / F`} intro="One idea worth returning to."
  footerText="Written at decision altitude. Sources remain attached."
  footerLink={briefingPath} footerLinkLabel="Return to the day’s signals →"
>
  <Content />
  {(entry.data.mediumUrl || entry.data.linkedinUrl) && (
    <aside class="distribution-links" aria-label="Article distribution">
      <p>Also published</p>
      {entry.data.mediumUrl && <a href={entry.data.mediumUrl} rel="noreferrer" target="_blank">Medium ↗</a>}
      {entry.data.linkedinUrl && <a href={entry.data.linkedinUrl} rel="noreferrer" target="_blank">LinkedIn ↗</a>}
    </aside>
  )}
</OuroborosPublication>

<style>
  .distribution-links { display: flex; flex-wrap: wrap; gap: .7rem 1rem; margin-top: 5rem; padding-top: 1.3rem; border-top: 1px solid var(--line); }
  .distribution-links p { flex-basis: 100%; margin: 0; color: var(--muted); font-family: var(--sans); font-size: .6rem; letter-spacing: .13em; text-transform: uppercase; }
  .distribution-links a { color: var(--gold-dark); font-family: var(--sans); font-size: .7rem; }
</style>

