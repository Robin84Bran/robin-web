---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { createArticleSchemas } from '../../../lib/seo';

export async function getStaticPaths() {
  const entries = await getCollection('dailyBriefing', ({ data }) => !data.draft);
  const actionItems = await getCollection('actionItem', ({ data }) => !data.draft);
  return entries.map((entry) => {
    const date = entry.data.date.toISOString().slice(0, 10).replaceAll('-', '');
    const hasActionItem = actionItems.some((item) => item.data.date.toISOString().slice(0, 10).replaceAll('-', '') === date);
    return {
      params: { yearMonth: date.slice(0, 6), date },
      props: { entry, hasActionItem },
    };
  });
}

interface Props {
  entry: CollectionEntry<'dailyBriefing'>;
  hasActionItem: boolean;
}

const { entry, hasActionItem } = Astro.props;
const { Content } = await render(entry);
const publicationDate = entry.data.date.toISOString().slice(0, 10);
const compactDate = publicationDate.replaceAll('-', '');
const path = `/ouroboros/${compactDate.slice(0, 6)}/${compactDate}/`;
const schemas = createArticleSchemas({
  title: entry.data.title,
  description: entry.data.excerpt,
  path,
  image: entry.data.ogImage,
  datePublished: publicationDate,
  dateModified: entry.data.updated.toISOString().slice(0, 10),
  keywords: entry.data.keywords,
  inLanguage: entry.data.inLanguage,
});
const displayDate = entry.data.date.toLocaleDateString('en-US', {
  timeZone: 'UTC', month: 'long', day: 'numeric', year: 'numeric',
});
---

<BaseLayout
  title={`${entry.data.title} | Robin Xie`}
  description={entry.data.excerpt}
  path={path}
  image={entry.data.ogImage}
  imageAlt={`Ouroboros signal field for ${displayDate}`}
  imageWidth={1200}
  imageHeight={630}
  type="article"
  schema={schemas}
>
  <article class="briefing shell">
    <header class="briefing-hero">
      <div class="briefing-kicker">
        <a href="/identity/ouroboros/">Ouroboros</a>
        <span aria-hidden="true">/</span>
        <span>Daily Briefing</span>
      </div>
      <h1>Signals<br />in motion.</h1>
      <p class="briefing-date"><time datetime={publicationDate}>{displayDate}</time></p>
      <figure class="briefing-visual">
        <img src={entry.data.hero} alt={`Abstract orbital field for ${displayDate}`} width="1600" height="900" fetchpriority="high" />
      </figure>
      <p class="briefing-intro">Seven signals. Two languages. One moving field.</p>
    </header>

    <div class="briefing-body">
      <Content />
    </div>

    <footer class="briefing-end" aria-label="End of briefing">
      <span>∞</span>
      <p>Observed. Interpreted. Returned to the loop.</p>
      {hasActionItem && <a href={`${path}action_item/`}>Read today’s action item →</a>}
    </footer>
  </article>
</BaseLayout>

<style>
  .briefing {
    padding-block: clamp(2rem, 6vw, 5rem) 6rem;
  }

  .briefing-hero {
    position: relative;
    min-height: min(82svh, 52rem);
    display: grid;
    align-content: start;
  }

  .briefing-kicker {
    display: flex;
    gap: .7rem;
    align-items: center;
    margin-bottom: clamp(2.4rem, 8vw, 5.5rem);
    color: var(--gold-dark);
    font-size: .68rem;
    font-weight: 650;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .briefing-kicker a { text-decoration: none; }

  .briefing h1 {
    position: relative;
    z-index: 2;
    width: min-content;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(3.3rem, 13vw, 7.8rem);
    font-weight: 400;
    letter-spacing: -.055em;
    line-height: .84;
  }

  .briefing-date {
    position: relative;
    z-index: 2;
    margin: 1.5rem 0 0 .2rem;
    color: var(--muted);
    font-size: .74rem;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .briefing-visual {
    position: relative;
    z-index: 1;
    width: min(100%, 56rem);
    margin: clamp(2rem, 8vw, 5rem) 0 0 auto;
    overflow: hidden;
    background: var(--stone);
    border: 1px solid rgba(83, 74, 65, .1);
    box-shadow: 0 2.2rem 5rem rgba(70, 58, 47, .08);
  }

  .briefing-visual img { width: 100%; height: auto; }

  .briefing-intro {
    justify-self: end;
    margin: 1.15rem 0 0;
    color: var(--muted);
    font-family: var(--serif);
    font-size: clamp(1rem, 3vw, 1.3rem);
    font-style: italic;
  }

  .briefing-body {
    width: min(100%, 47rem);
    margin: clamp(4rem, 12vw, 9rem) auto 0;
    font-family: var(--serif);
    font-size: clamp(1.02rem, 2vw, 1.16rem);
    line-height: 1.86;
  }

  .briefing-body :global(h1) {
    margin: 0 0 4rem;
    font-size: clamp(1.8rem, 5vw, 3rem);
    line-height: 1.15;
  }

  .briefing-body :global(h2) {
    margin: 7rem 0 3.5rem;
    padding-top: 2rem;
    font-size: clamp(1.55rem, 4vw, 2.3rem);
    font-weight: 400;
    border-top: 1px solid var(--line);
  }

  .briefing-body :global(h3) {
    margin: 4.8rem 0 2rem;
    font-size: clamp(1.3rem, 3vw, 1.75rem);
    font-weight: 400;
    line-height: 1.35;
  }

  .briefing-body :global(p) { margin-bottom: 1.45rem; }
  .briefing-body :global(strong) { font-family: var(--sans); font-size: .92em; }
  .briefing-body :global(a) { text-decoration-color: var(--sakura); text-underline-offset: .22em; }
  .briefing-body :global(hr) { width: 3rem; margin: 4.5rem auto; border: 0; border-top: 1px solid var(--gold); }

  .briefing-end {
    display: grid;
    justify-items: center;
    margin-top: 7rem;
    color: var(--muted);
    text-align: center;
  }

  .briefing-end span { color: var(--sakura); font-family: var(--serif); font-size: 2rem; }
  .briefing-end p { font-family: var(--serif); font-size: .9rem; font-style: italic; }
  .briefing-end a { margin-top: .8rem; color: var(--gold-dark); font-size: .72rem; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }

  @media (min-width: 50rem) {
    .briefing-hero { grid-template-columns: minmax(15rem, .55fr) 1fr; column-gap: 3rem; }
    .briefing-kicker { grid-column: 1 / -1; }
    .briefing-visual { grid-column: 2; grid-row: 2 / span 3; margin-top: -2rem; }
    .briefing h1, .briefing-date { grid-column: 1; }
    .briefing-intro { grid-column: 2; }
  }
</style>
