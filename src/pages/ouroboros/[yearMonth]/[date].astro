---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import OuroborosPublication from '../../../components/OuroborosPublication.astro';
import { createArticleSchemas } from '../../../lib/seo';

export async function getStaticPaths() {
  const entries = await getCollection('dailyBriefing', ({ data }) => !data.draft);
  const actionItems = await getCollection('actionItem', ({ data }) => !data.draft);
  return entries.map((entry) => {
    const date = entry.data.date.toISOString().slice(0, 10).replaceAll('-', '');
    return {
      params: { yearMonth: date.slice(0, 6), date },
      props: { entry, hasActionItem: actionItems.some((item) => item.data.date.toISOString().slice(0, 10).replaceAll('-', '') === date) },
    };
  });
}

interface Props { entry: CollectionEntry<'dailyBriefing'>; hasActionItem: boolean; }
const { entry, hasActionItem } = Astro.props;
const { Content } = await render(entry);
const publicationDate = entry.data.date.toISOString().slice(0, 10);
const compactDate = publicationDate.replaceAll('-', '');
const path = `/ouroboros/${compactDate.slice(0, 6)}/${compactDate}/`;
const languages = [
  { hreflang: 'en', label: 'English', path },
  { hreflang: 'zh-Hans', label: '简体中文', path: `${path}zh-hans/` },
  { hreflang: 'zh-Hant', label: '繁體中文', path: `${path}zh-hant/` },
  { hreflang: 'ja', label: '日本語', path: `${path}ja/` },
];
const schemas = createArticleSchemas({
  title: entry.data.title, description: entry.data.excerpt, path, image: entry.data.ogImage,
  datePublished: publicationDate, dateModified: entry.data.updated.toISOString().slice(0, 10),
  keywords: entry.data.keywords, inLanguage: entry.data.inLanguage,
});
const displayDate = entry.data.date.toLocaleDateString('en-US', { timeZone: 'UTC', month: 'long', day: 'numeric', year: 'numeric' });
---

<OuroborosPublication
  kind="briefing" title={entry.data.title} description={entry.data.excerpt} {path}
  image={entry.data.ogImage} imageAlt={`Ouroboros signal field for ${displayDate}`}
  hero={entry.data.hero} heroAlt={`Abstract orbital field for ${displayDate}`}
  {publicationDate} {displayDate} schema={schemas} language="en" alternates={languages}
  languageLinks={languages.filter((item) => item.hreflang !== 'en')}
  crumbs={[{ label: 'Ouroboros', href: '/ouroboros/' }, { label: 'Daily Briefing' }]}
  intro="Eight signals. Four languages. One moving field."
  footerText="Observed. Interpreted. Returned to the loop."
  footerLink={hasActionItem ? `${path}action_item/` : undefined}
  footerLinkLabel={hasActionItem ? 'Read today’s action item →' : undefined}
>
  <Content />
</OuroborosPublication>
