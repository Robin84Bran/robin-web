---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { identityWords, pressLinks } from '../../data/site';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return identityWords.map((entry, index) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      index,
      previous: identityWords[(index + identityWords.length - 1) % identityWords.length],
      next: identityWords[(index + 1) % identityWords.length],
    },
  }));
}

interface Props {
  entry: (typeof identityWords)[number];
  index: number;
  previous: (typeof identityWords)[number];
  next: (typeof identityWords)[number];
}

const { entry, index, previous, next } = Astro.props;
const isPressDirectory = entry.slug === 'network';
const isOuroborosDirectory = entry.slug === 'ouroboros';
const latestBriefing = isOuroborosDirectory
  ? (await getCollection('dailyBriefing', ({ data }) => !data.draft)).sort(
      (a, b) => b.data.date.getTime() - a.data.date.getTime(),
    )[0]
  : undefined;
const briefingDate = latestBriefing?.data.date.toISOString().slice(0, 10).replaceAll('-', '');
---

<BaseLayout
  title={`${entry.word} — I AM ROBIN`}
  description={`${entry.word}: a living project directory inside the I AM ROBIN identity map.`}
  path={`/identity/${entry.slug}/`}
  noindex={true}
>
  <section class="identity-directory shell">
    <a class="directory-back" href="/">← I AM ROBIN</a>
    <div class={`directory-letter directory-letter--${entry.tone}`} aria-hidden="true">{entry.letter}</div>
    <p class="eyebrow">{String(index + 1).padStart(2, '0')} / 08 · project directory</p>
    <h1>{entry.word}</h1>
    {
      isOuroborosDirectory && latestBriefing && briefingDate ? (
        <section class="press-directory" aria-labelledby="briefing-directory-title">
          <h2 id="briefing-directory-title">Daily Briefing</h2>
          <nav aria-label="Latest Daily Briefing">
            <a href={`/ouroboros/${briefingDate.slice(0, 6)}/${briefingDate}/`}>
              <small>{latestBriefing.data.date.toLocaleDateString('en-US', { timeZone: 'UTC', month: 'long', day: 'numeric', year: 'numeric' })}</small>
              <strong>Signals in motion.</strong>
              <span aria-hidden="true">→</span>
            </a>
          </nav>
        </section>
      ) : isPressDirectory ? (
        <section class="press-directory" aria-labelledby="press-directory-title">
          <h2 id="press-directory-title">Press</h2>
          <nav aria-label="Selected press">
            {pressLinks.map((item) => (
              <a href={item.href} rel="noreferrer" target="_blank">
                <small>{item.source}</small>
                <strong>{item.label}</strong>
                <span aria-hidden="true">↗</span>
              </a>
            ))}
          </nav>
        </section>
      ) : (
        <ul>
          {entry.projects.map((project) => <li><span></span>{project}</li>)}
          <li class="directory-future"><span></span>more, as it becomes</li>
        </ul>
      )
    }
    <nav aria-label="Identity directories">
      <a href={`/identity/${previous.slug}/`}>← {previous.word}</a>
      <a href={`/identity/${next.slug}/`}>{next.word} →</a>
    </nav>
  </section>
</BaseLayout>
