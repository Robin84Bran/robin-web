---
import { getCollection, render } from 'astro:content';
import ButtonLink from '../../components/ui/ButtonLink.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortCollectionByOrder } from '../../lib/content';
import { getProjectPath, type ProjectEntry } from '../../lib/projects';
import {
  createBreadcrumbSchema,
  createPersonSchema,
  createProjectSchema,
} from '../../lib/seo';

export async function getStaticPaths() {
  const projects = sortCollectionByOrder(await getCollection('projects'));

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props as { project: ProjectEntry };
const { Content } = await render(project);
const pagePath = getProjectPath(project.id);
---

<BaseLayout
  description={project.data.summary}
  image="/og/projects.jpg"
  path={pagePath}
  schema={[
    createPersonSchema(),
    createProjectSchema(project),
    createBreadcrumbSchema([
      { name: 'Projects', path: '/projects/' },
      { name: project.data.title, path: pagePath },
    ]),
  ]}
  title={`${project.data.title} | Projects | Robin Xie`}
>
  <section class="section-shell pt-0">
    <nav aria-label="Breadcrumb" class="type-action flex flex-wrap items-center gap-2 text-[var(--color-muted)]">
      <a class="transition-colors hover:text-[var(--color-ink)]" href="/projects/">Projects</a>
      <span aria-hidden="true">/</span>
      <span class="text-[var(--color-ink)]">{project.data.title}</span>
    </nav>

    <header class="mt-8 max-w-4xl">
      <div class="flex flex-wrap items-center gap-3">
        <p class="eyebrow">{project.data.status}</p>
        <span class="type-meta rounded-full border border-[var(--color-line)] px-3 py-1 text-[var(--color-muted)]">
          {project.data.domain}
        </span>
      </div>
      <h1 class="type-heading mt-5 text-[var(--color-ink)]">{project.data.title}</h1>
      <p class="type-lead mt-5 max-w-3xl text-[var(--color-ink)]/86">{project.data.summary}</p>
      <p class="type-body mt-5 max-w-3xl text-[var(--color-muted)]">{project.data.impact}</p>
    </header>
  </section>

  <section class="section-shell pt-0">
    <div class="grid gap-5 lg:grid-cols-[minmax(0,1.25fr)_minmax(16rem,0.75fr)]">
      <article class="glass-card p-7 sm:p-8">
        <p class="eyebrow">What it is</p>
        <div class="prose-robin mt-5">
          <Content />
        </div>
      </article>

      <aside class="glass-card p-7 sm:p-8" aria-label="Project facts">
        <p class="eyebrow">Public snapshot</p>
        <dl class="mt-5 space-y-5">
          <div>
            <dt class="type-meta text-[var(--color-muted)]">Status</dt>
            <dd class="type-body mt-1 text-[var(--color-ink)]">{project.data.status}</dd>
          </div>
          <div>
            <dt class="type-meta text-[var(--color-muted)]">Domain</dt>
            <dd class="type-body mt-1 text-[var(--color-ink)]">{project.data.domain}</dd>
          </div>
        </dl>
      </aside>
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      <ButtonLink href="/projects/" variant="secondary">Back to projects</ButtonLink>
      <ButtonLink href="/about/" variant="ghost">About Robin</ButtonLink>
    </div>
  </section>
</BaseLayout>
