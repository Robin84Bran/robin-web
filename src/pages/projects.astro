---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageLead from '../components/PageLead.astro';
import ProjectCompass from '../components/ProjectCompass.astro';
---

<BaseLayout
  title="Projects — Robin Xie"
  description="Four directions in Robin Xie's project world: system, research, learning, and play."
  path="/projects/"
  noindex={true}
>
  <PageLead eyebrow="Projects / four states" title="One center. Four directions." line="system · research · learn · play" />
  <div class="shell projects-canvas">
    <ProjectCompass />
  </div>
  <p class="page-afterword shell">Not a catalogue. A living compass.</p>
</BaseLayout>
