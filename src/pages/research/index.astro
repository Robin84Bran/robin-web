---
import BaseLayout from '../../layouts/BaseLayout.astro';
const path = '/research/';
const description = 'Independent research by Robin Xie on evidence and oversight, coordination and delegation, and memory, adaptation and resilience.';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://iamrobin.ai/research/#collection',
  name: 'Research — Robin Xie',
  description,
  url: 'https://iamrobin.ai/research/',
  inLanguage: 'en',
  hasPart: [{ '@type': 'Article', name: 'The Honest Agent', url: 'https://iamrobin.ai/research/honestagent/' }],
};
---
<BaseLayout title="Research — I AM ROBIN" {path} {description} {schema}>
  <section class="shell research-index">
    <a class="quiet-link" href="/">← I AM ROBIN</a>
    <p class="eyebrow">04 / 08 · Research</p>
    <h1>Research</h1>
    <p class="lead">How intelligent systems act, coordinate and remain useful.</p>
    <section aria-labelledby="honestagent-title">
      <p class="eyebrow">Evidence and oversight · Research study</p>
      <h2 id="honestagent-title"><a href="/research/honestagent/">The Honest Agent</a></h2>
      <p>What should a monitor observe before trusting an agent’s report?</p>
      <a class="quiet-link" href="/research/honestagent/">Read the study →</a>
    </section>
    <p><a class="quiet-link" href="/intelligence/">Explore the playable experiments and visual explanations →</a></p>
  </section>
</BaseLayout>
<script is:inline>
  const oldArticleAnchors = ["test-title", "found-title", "twist-title", "surprise-title", "limits-title", "built-title", "next-title"];
  if (oldArticleAnchors.includes(window.location.hash.slice(1))) {
    window.location.replace('/research/honestagent/' + window.location.search + window.location.hash);
  }
</script>
<style>
  .research-index{padding-block:3rem 6rem;min-height:75vh}
  .research-index>h1{font:400 clamp(2.5rem,6vw,4.5rem)/1.1 var(--serif);letter-spacing:-.04em;margin-top:1.3rem}
  .research-index .lead{max-width:42rem;font:400 clamp(1.3rem,3vw,1.8rem)/1.5 var(--serif)}
  .research-index section{margin-block:2.5rem;padding-block:2rem;border-block:1px solid var(--line)}
  .research-index h2{font:400 clamp(1.8rem,4vw,2.6rem)/1.2 var(--serif);margin-bottom:1rem}
  .research-index h2 a{text-decoration:none}
  .research-index section>p:not(.eyebrow){color:var(--muted);line-height:1.7}
</style>
