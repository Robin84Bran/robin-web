const path = '/research/useful-core/';
const description = 'The Useful Core: all 900 local episodes delivered nothing, while 104/400 outage reports falsely claimed full delivery. Fallback instructions failed the joint test; simple scripts reached the ceiling.';
const evidence = 'https://github.com/Robin84Bran/research/tree/main/useful-core/collection/delivery';
const schema = {
  '@context': 'https://schema.org', '@type': 'Article',
  '@id': `https://iamrobin.ai${path}#article`,
  headline: 'The Useful Core — A useful artifact is not a delivery.',
  description, url: `https://iamrobin.ai${path}`, inLanguage: 'en',
