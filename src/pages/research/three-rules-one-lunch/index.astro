  .strategy-table tbody th { min-width: 13rem; font-weight: 400; }
  .strategy-table small { display: block; color: var(--muted); margin-top: 0.3rem; font-size: 0.75rem; }
  .strategy-table .primary-row { background: var(--moon-bright); }
  .strategy-table .primary-row th { border-left: 3px solid var(--gold-dark); font-weight: 600; }
  .script-table, .prediction-table { min-width: 38rem; }
  details { margin-top: 1.5rem; border-block: 1px solid var(--line); padding-block: 1rem; font-size: 0.9rem; }
  summary { cursor: pointer; font-weight: 600; }
  details p { margin: 1rem 0 0; }
  dt { font-weight: 600; margin-top: 1.2rem; }
  dd { margin-left: 0; }
  .fine { font-size: 0.85rem; line-height: 1.7; }
  .next-links { display: flex; flex-wrap: wrap; gap: 1rem 2rem; padding-top: 1rem; color: var(--gold-dark); }
  @media (max-width: 650px) {
    .figures, .chart-grid { grid-template-columns: 1fr; }
    .cohort { min-height: 0; }
  }
</style>
