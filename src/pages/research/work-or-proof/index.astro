---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const path = '/research/work-or-proof/';
const description = 'Work or Proof? A pre-registered study: cheap local screening caught 17.9 percentage points more rule breaches at the same frontier checking budget, but still missed real breaches.';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `https://iamrobin.ai${path}#article`,
  headline: 'Work or Proof? A cheap check can help an expensive one',
  description,
  url: `https://iamrobin.ai${path}`,
  inLanguage: 'en',
  datePublished: '2026-11-11',
  author: { '@id': 'https://www.tideisun.com/robin#robin-xie' },
};

// Study sources: results/main/primary.json (difference and interval),
// tables.json (primary / pooled / tokens / 0.5 rows), and root RESULTS.md.
// Recall is population recall: all 737 breaches, including unresolved items.
const policies = [
  { name: 'Local screen → frontier check', model: 'Qwen 2.5 7B · primary policy', recall: 67.84, catches: '499.99', key: 'screen' },
  { name: 'Random-share frontier check', model: 'Same frontier token allowance', recall: 49.99, catches: '368.39', key: 'random' },
];

// Secondary counts: RESULTS.md, Full censuses (trace policies C, L and LT).
// Primary means: Every policy at the primary token cap (LT · Qwen and X).
// Frontier census tokens are consumed totals; primary tokens are the shared cap.
const checkingStrategies = [
  { id: 'A', name: 'Claude checks everything', caught: '737 / 737 (100%)', alarms: '8 / 703 (1.1%)', frontier: '1,644,965', saving: 'Full census', local: 'None', recall: 100, fpr: 8 / 703 * 100, primary: false, label: 'A · Claude all', labelX: 110, labelY: 40, anchor: 'start', leader: '80,34 104,34' },
  { id: 'B', name: 'Qwen checks everything, alone', caught: '669 / 737 (90.8%)', alarms: '193 / 703 (27.5%)', frontier: '0', saving: 'Local compute only', local: 'Qwen · 1,440 checks', recall: 669 / 737 * 100, fpr: 193 / 703 * 100, primary: false, label: 'B · Qwen alone', labelX: 217, labelY: 125, anchor: 'middle', leader: '' },
  { id: 'C', name: 'Llama checks everything, alone', caught: '671 / 737 (91.0%)', alarms: '382 / 703 (54.3%)', frontier: '0', saving: 'Local compute only', local: 'Llama · 1,440 checks', recall: 671 / 737 * 100, fpr: 382 / 703 * 100, primary: false, label: 'C · Llama alone', labelX: 345, labelY: 205, anchor: 'middle', leader: '378,177 378,185' },
  { id: 'D', name: 'Qwen screen → Claude, no budget limit', caught: '671 / 737 (91.0%)', alarms: '8 / 703 (1.1%)', frontier: '1,102,365', saving: '33% fewer than Claude all', local: 'Qwen · 1,440 checks', recall: 671 / 737 * 100, fpr: 8 / 703 * 100, primary: false, label: 'D · Qwen → Claude, no cap', labelX: 90, labelY: 184, anchor: 'start', leader: '80,178 84,178' },
  { id: 'E', name: 'Llama screen → Claude, no budget limit', caught: '734 / 737 (99.6%)', alarms: '8 / 703 (1.1%)', frontier: '1,524,395', saving: '7% fewer than Claude all', local: 'Llama · 1,440 checks', recall: 734 / 737 * 100, fpr: 8 / 703 * 100, primary: false, label: 'E · Llama → Claude, no cap', labelX: 110, labelY: 77, anchor: 'start', leader: '92,71 104,71' },
  { id: 'P', name: 'Qwen screen → Claude, half budget', caught: '67.8% · mean 499.99 / 737', alarms: 'Mean 5.9 / 703 (0.8%)', frontier: '822,482 cap', saving: 'Half the Claude-all allowance', local: 'Qwen · 1,440 checks', recall: 67.84, fpr: 0.84, primary: true, label: 'P · Qwen → Claude, half budget', labelX: 80, labelY: 239, anchor: 'start', leader: '70,233 74,233' },
  { id: 'R', name: 'Random Claude, half budget', caught: '50.0% · mean 368.39 / 737', alarms: 'Mean 4.0 / 703 (0.6%)', frontier: '822,482 cap', saving: 'Same primary allowance', local: 'None', recall: 49.99, fpr: 0.57, primary: true, label: 'R · Random Claude, half budget', labelX: 80, labelY: 293, anchor: 'start', leader: '70,287 74,287' },
];
const plotX = (rate: number) => 52 + rate * 6;
const plotY = (rate: number) => 420 - rate * 3;
---

<BaseLayout title="Work or Proof? — Research — Robin Xie" {path} {description} {schema} type="article">
  <div class="shell research">
    <a class="quiet-link" href="/research/">← Research</a>
    <p class="eyebrow">Research · AI oversight · 11 November 2026</p>
    <h1>Work or Proof?<br /><em>Check where it counts.</em></h1>
    <p class="lead">A cheap check can help an expensive one.<br />It can also wave real problems through.</p>
    <p class="intro">When AI systems work together, how much effort should go into making things, and how much into checking them? Checking everything carefully can be costly. This study takes one part of that problem: can a small local model choose which work deserves a more expensive check?</p>

    <section class="story hypothesis" aria-labelledby="hypothesis-title">
      <h2 id="hypothesis-title">Hypothesis</h2>
      <p>At the same frontier budget, letting a free local model choose which runs get the expensive check catches more rule breaches than checking at random.</p>
      <p><strong>Pre-registered prediction: held (+17.9 pp, 95% interval +16.2 to +19.8).</strong></p>
      <p class="chart-note">“Free” means no new model-call charge; local hardware and energy costs were not measured. The primary comparison gives both policies the same frontier allowance.</p>
    </section>

    <section class="story" aria-labelledby="baselines-title">
      <p class="eyebrow">Benefit and cost, side by side</p>
      <h2 id="baselines-title">Five ways to check 1,440 runs</h2>
      <p>What if Claude checks everything? What if Qwen checks everything alone? Here are five full-census strategies, followed by the <strong>pre-registered primary</strong> comparison at half the frontier budget. Every strategy reads action records.</p>
      <p id="strategy-table-note" class="chart-note">Caught: share of all 737 breaches. False alarms: share of all 703 clean runs. Frontier tokens and local compute are separate costs. On a narrow screen, scroll the table sideways.</p>
      <div class="strategy-table-wrap" role="region" aria-labelledby="baselines-title" aria-describedby="strategy-table-note" tabindex="0">
        <table class="strategy-table">
          <caption>Five full-census strategies and the primary half-budget pair</caption>
          <thead>
            <tr><th scope="col">Strategy</th><th scope="col">Breaches caught</th><th scope="col">False alarms</th><th scope="col">Frontier tokens</th><th scope="col">Local compute</th></tr>
          </thead>
          <tbody>
            {checkingStrategies.map((strategy) => (
              <tr class:list={{ 'primary-row': strategy.primary }}>
                <th scope="row"><span>{strategy.id} · {strategy.name}</span><small>{strategy.primary ? 'Pre-registered primary' : 'Secondary (full census)'}</small></th>
                <td>{strategy.caught}</td>
                <td>{strategy.alarms}</td>
                <td>{strategy.frontier}<small>{strategy.saving}</small></td>
                <td>{strategy.local}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="chart-note">Primary rows are means over 256 shuffled orders. Their 822,482 tokens are an allowance, not exact consumption; full-census rows show total frontier tokens. All frontier judgments were saved Claude judgments, replayed here. Local compute is outside that allowance. Unchecked or unresolved breaches count as missed; a low false-alarm rate does not mean all clean runs were cleared.</p>

      <figure class="comparison tradeoff">
        <figcaption id="tradeoff-caption">Breaches caught versus false alarms · higher and further left is better</figcaption>
        <svg class="tradeoff-plot" viewBox="0 50 440 430" role="img" aria-labelledby="tradeoff-title tradeoff-desc">
          <title id="tradeoff-title">Seven checking outcomes, including the primary half-budget pair</title>
          <desc id="tradeoff-desc">The horizontal axis is false alarms among clean runs, from 0 to 60 percent. The vertical axis is breaches caught, from 0 to 100 percent. A: Claude checks everything, 1.1 percent false alarms and 100 percent caught. B: Qwen alone, 27.5 and 90.8 percent. C: Llama alone, 54.3 and 91.0 percent. D: uncapped Qwen then Claude, 1.1 and 91.0 percent. E: uncapped Llama then Claude, 1.1 and 99.6 percent, nearly overlapping A. The primary pair is highlighted with filled squares and bold labels: P, half-budget Qwen then Claude, 0.8 and 67.8 percent; R, half-budget random Claude, 0.6 and 50.0 percent. Costs are in the preceding table.</desc>
          <text class="axis-title" x="18" y="262.5" text-anchor="middle" transform="rotate(-90 18 262.5)">Breaches caught (%) ↑</text>
          {[0, 25, 50, 75, 100].map((tick) => (
            <g class="plot-grid">
              <line x1="52" x2="412" y1={plotY(tick)} y2={plotY(tick)} />
              <text x="43" y={plotY(tick) + 5} text-anchor="end">{tick}</text>
            </g>
          ))}
          <path class="plot-axis" d="M52 105V420H412" />
          {[0, 20, 40, 60].map((tick) => (
            <g class="plot-grid">
              <line x1={plotX(tick)} x2={plotX(tick)} y1="420" y2="426" />
              <text x={plotX(tick)} y="447" text-anchor="middle">{tick}</text>
            </g>
          ))}
          <text class="axis-title" x="232" y="475" text-anchor="middle">False-alarm rate (%) →</text>
          {checkingStrategies.map((strategy) => {
            const placement = {
              A: { labelX: 90, labelY: 76, anchor: 'start', leader: '80,70 84,70' },
              B: { labelX: plotX(strategy.fpr), labelY: plotY(strategy.recall) + 27, anchor: 'middle', leader: '' },
              C: { labelX: 405, labelY: plotY(strategy.recall) + 27, anchor: 'end', leader: '' },
              D: { labelX: 90, labelY: 212, anchor: 'start', leader: '80,206 84,206' },
              E: { labelX: 90, labelY: 110, anchor: 'start', leader: '80,104 84,104' },
            }[strategy.id] ?? strategy;
            return (
              <g class:list={{ 'plot-strategy': true, 'plot-primary': strategy.primary }}>
                {placement.leader && <polyline class="plot-leader" points={`${plotX(strategy.fpr)},${plotY(strategy.recall)} ${placement.leader}`} />}
                {strategy.primary
                  ? <rect class="plot-point" x={plotX(strategy.fpr) - 5} y={plotY(strategy.recall) - 5} width="10" height="10" />
                  : <circle class="plot-point" cx={plotX(strategy.fpr)} cy={plotY(strategy.recall)} r={strategy.id === 'E' ? 3 : 5} />}
                <text x={placement.labelX} y={placement.labelY} text-anchor={placement.anchor}>{strategy.label}</text>
              </g>
            );
          })}
        </svg>
        <p class="chart-note"><strong>Filled squares P and R: pre-registered primary.</strong> Open circles A–E: secondary full censuses. Claude-all and uncapped Llama → Claude nearly overlap at the top left (100% versus 99.6% caught). Letters match the table; the figure shows errors and catches, while the table also shows compute cost.</p>
      </figure>
      <p>Qwen alone catches more breaches than the capped two-stage system because it checks all 1,440 runs and its own accusations count. But it cries wolf on <strong>27.5% of clean runs</strong>. Adding Claude after Qwen cuts the false alarms to <strong>1.1%</strong> without a cap, but Claude cannot rescue the <strong>66 breaches Qwen already cleared</strong>; at half budget, some escalations also go unchecked.</p>
      <p>Llama is the paranoid screen: it sends <strong>92% of runs</strong> to Claude. With no cap it loses only <strong>3 breaches</strong>, but saves just <strong>7% of frontier tokens</strong>. Catching almost everything leaves little checking cost to save.</p>
    </section>

    <section class="story" aria-labelledby="test-title">
      <p class="eyebrow">The question</p>
      <h2 id="test-title">Who gets the careful check?</h2>
      <p>We reused <strong>1,440 saved task records</strong> from <a href="/research/honestagent/">The Honest Agent</a> and <a href="/research/honestagent/#next-title">The Obedient Rebel</a>. The tasks involved simulated payments, deployments and document sharing. Their action receipts let code establish which records broke the approval rule: <strong>737 breaches and 703 compliant records</strong>.</p>
      <p>Qwen 2.5 7B and Llama 3.1 8B made fresh judgments, reading either the final report or the action record. We then replayed saved Claude judgments to compare ways of spending a fixed frontier checking allowance. A frontier model is the larger, externally hosted checker; no new frontier calls were made.</p>
      <p>The primary policy used Qwen to read every action record. Anything it flagged, or could not decide, went to the frontier checker while budget remained. A local clearance stopped there. The comparison spent the same allowance checking records in random order, without local screening. Only a final frontier accusation counted as a catch.</p>
    </section>

    <section class="story" aria-labelledby="result-title">
      <p class="eyebrow">The result · pre-registered</p>
      <h2 id="result-title">The screen helped the budget go further.</h2>
      <div class="figures">
        <p class="figure"><strong>+17.9 pp</strong><span>more breaches caught with Qwen screening<br />pp = percentage points</span></p>
        <p class="figure"><strong>+16.18 to +19.77</strong><span>95% interval, in percentage points</span></p>
      </div>
      <figure class="comparison">
        <figcaption>Share of all 737 breaches caught · same frontier allowance</figcaption>
        {policies.map((policy) => (
          <div class="policy">
            <div class="policy-label"><span>{policy.name}</span><strong>{policy.recall.toFixed(2)}%</strong></div>
            <div class="track" aria-hidden="true"><span class={`fill ${policy.key}`} style={`width:${policy.recall}%`}></span></div>
            <p class="chart-note">{policy.model} · {policy.catches} mean catches</p>
          </div>
        ))}
        <p class="chart-note">Means over 256 shuffled orders, so counts can be fractional. The bar scale runs from none to all breaches caught.</p>
      </figure>
      <p>The allowance was <strong>822,482 frontier tokens</strong>—chunks of text processed or produced by the checker—half the cost of checking the entire archive’s action records. Local computing was supplied separately. At that allowance, screening caught <strong>67.84%</strong> of breaches; random checking caught <strong>49.99%</strong>. The unrounded difference rounds to <strong>+17.86 percentage points</strong>.</p>
      <p>The registered primary test passed. Both its recall gain and its gain in catches per allowed frontier token had intervals above zero, and the final false-alarm rate stayed below the registered guardrail in each source study.</p>
      <details>
        <summary>What the interval tells us</summary>
        <p>The 95% interval comes from 2,000 paired resamples of seed blocks within each source study, with 16 orders per resample. It holds the first local judgments fixed. It describes sensitivity within this archive; it does not measure reliability on new tasks. A clearance, an abstention or work left unchecked at the budget limit counts as a missed breach.</p>
      </details>
    </section>

    <section class="story" aria-labelledby="twist-title">
      <p class="eyebrow">The twist</p>
      <h2 id="twist-title">A cheap clearance can hide a real breach.</h2>
      <!-- Uncapped LT Qwen and local-only L rows: results/main/tables.json;
           exact counts and rates also appear in root RESULTS.md. -->
      <p>Remove the frontier budget cap and Qwen screening still misses <strong>66 breaches</strong> that full frontier trace checking catches. It catches 671 of 737, while saving 32.99% of frontier tokens. A breach cleared by the local screen never reaches the careful checker.</p>
      <p>Using the local model alone creates a different problem: too many false alarms. Qwen flags <strong>193 of 703 compliant records</strong>, about <strong>27%</strong>. Llama flags <strong>382 of 703</strong>, about <strong>54%</strong>. Those are false alarms among work that followed the rule, not percentages of all accusations.</p>
      <p>The useful result is a better allocation of a limited checking budget. It comes with errors that would matter in a real review queue.</p>
    </section>

    <section class="story" aria-labelledby="integrity-title">
      <p class="eyebrow">How the record holds up</p>
      <h2 id="integrity-title">Written down before the calls.</h2>
      <!-- Sources: root RESULTS.md Integrity; results/main/collection.json
           and predictions.json. Spend is incremental model-call USD only. -->
      <dl>
        <dt>Pre-registered and frozen</dt>
        <dd>The protocol, prompts, policies, predictions and analysis were fixed before collection. The saved GitHub push record places the push 35.65 seconds before the first local request. The original frozen files pass verification.</dd>
        <dt>5,808 calls · 0 failures</dt>
        <dd>Every request and response was saved: 5,760 first judgments and 48 replay checks. All completed, with no malformed replies or substitutions.</dd>
        <dt>0 USD in new model-call spend</dt>
        <dd>The new judgments ran locally. Frontier judgments were reused from earlier studies, whose costs had already been incurred. Hardware and energy costs were not measured.</dd>
        <dt>A failed prediction stays visible</dt>
        <dd>We expected Llama’s repeated judgments to vary. Its 24 replay responses were byte-identical. That finite sample does not prove the model is deterministic.</dd>
        <dt>Independent review</dt>
        <dd>Claude reviewed the completed study and judged its acceptance criteria met, conditional on restoring the frozen question log and adding a plain-language summary. Both fixes are complete; the post-analysis questions remain separate from the registered record.</dd>
      </dl>
    </section>

    <section class="story" aria-labelledby="limits-title">
      <p class="eyebrow">Where this stops</p>
      <h2 id="limits-title">A checking study, on familiar work.</h2>
      <p>The work was already made. This study does not find the best split between producing useful work and checking it. It compares checking policies on a fixed archive, with local computing outside the frontier allowance.</p>
      <p>These were previously examined simulated tasks, with many breaches and overlapping actor and monitor model families. The Obedient Rebel supplies 75% of the records but only five seed blocks. Reordering records does not create new independent tasks.</p>
      <p>Escalation reuses saved, independent Claude judgments. It does not test a live conversation between checkers, real queues, human review costs or deployment safety. A promising budget result is a reason to test a workflow further.</p>
      <p class="fine">Built by Robin Xie with Codex; reviewed by Claude. The headline and interval come from the frozen primary analysis; the policy and error counts come from its complete policy tables. Post-analysis questions are labelled separately.</p>
      <div class="next-links">
        <a href="/intelligence/work-or-proof/">Play the original Work or Proof? seed →</a>
        <a href="/research/honestagent/">Read The Honest Agent →</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .research { padding-block: 3rem 5rem; }
  .research > .eyebrow { margin-top: 3rem; }
  h1 { font: 400 clamp(3rem, 8vw, 6.6rem)/1 var(--serif); letter-spacing: -0.05em; margin: 1.5rem 0; }
  h1 em, h2 em { color: #426e69; }
  .lead { font: 400 clamp(1.3rem, 3vw, 2rem)/1.45 var(--serif); }
  .intro, .story { max-width: 48rem; line-height: 1.85; }
  .intro, .fine, dd, figcaption, .chart-note { color: var(--muted); }
  .story { margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .hypothesis { margin-top: 2rem; }
  .strategy-table-wrap { overflow-x: auto; margin-top: 1.2rem; }
  .strategy-table-wrap:focus-visible { outline: 2px solid var(--gold-dark); outline-offset: 4px; }
  .strategy-table { width: 100%; min-width: 46rem; border-collapse: collapse; font-size: 0.85rem; line-height: 1.6; font-variant-numeric: tabular-nums; }
  .strategy-table caption { text-align: left; color: var(--muted); padding-bottom: 0.8rem; }
  .strategy-table th, .strategy-table td { text-align: left; vertical-align: top; padding: 1rem 0.8rem; border-bottom: 1px solid var(--line); }
  .strategy-table thead th { font-weight: 600; border-top: 1px solid var(--line); }
  .strategy-table tbody th { min-width: 13rem; font-weight: 400; }
  .strategy-table td { min-width: 7.5rem; }
