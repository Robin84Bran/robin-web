  .figure { display: grid; gap: 0.5rem; margin: 0; padding-block: 1.1rem; border-top: 1px solid var(--line); }
  .figure strong { font: 400 clamp(1.8rem, 4vw, 2.8rem)/1.15 var(--serif); letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .figure span { color: var(--muted); font-size: 0.86rem; line-height: 1.6; }
  .comparison { margin: 2rem 0; padding: clamp(1rem, 3vw, 1.6rem); border: 1px solid var(--line); background: var(--moon-bright); }
  figcaption { font-size: 0.85rem; margin-bottom: 1.2rem; }
  .policy + .policy { margin-top: 1.4rem; }
  .policy-label { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; line-height: 1.5; font-size: 0.95rem; }
  .policy-label strong { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .track { height: 0.9rem; margin-block: 0.5rem; background: var(--stone); }
  .fill { display: block; height: 100%; background: #426e69; }
  .fill.random { background: var(--gold-dark); }
  .chart-note { font-size: 0.78rem; line-height: 1.6; margin-bottom: 0; }
  .comparison > .chart-note { margin-top: 1.5rem; }
  details { margin-top: 1.5rem; border-block: 1px solid var(--line); padding-block: 1rem; font-size: 0.9rem; }
  summary { cursor: pointer; font-weight: 600; }
  details p { margin: 1rem 0 0; }
  dt { font-weight: 600; margin-top: 1.2rem; }
  dd { margin-left: 0; }
  .fine { font-size: 0.85rem; line-height: 1.7; }
  .next-links { display: flex; flex-wrap: wrap; gap: 1rem 2rem; padding-top: 1rem; color: var(--gold-dark); }
  @media (max-width: 650px) {
    .figures { grid-template-columns: 1fr; }
    .policy-label { font-size: 0.85rem; }
  }
</style>
