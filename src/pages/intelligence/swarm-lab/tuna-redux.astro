---
import SeoHead from '../../../components/SeoHead.astro';
const path = '/intelligence/swarm-lab/tuna-redux/';
const title = 'TUNA Redux — Subsea Swarm Replay';
const description = 'Replay a simulated outage as 32 autonomous subsea agents maintain connectivity among four terminals.';
---
<!doctype html>
<html lang="en">
<head>
<SeoHead {title} {description} {path} schema={{ "@type": "WebPage", name: title, description, url: new URL(path, "https://iamrobin.ai").href, inLanguage: "en" }} />
<style is:global>
:root{color-scheme:dark;--ink:#e9f2f3;--muted:#91a8ad;--line:#355860;--ok:#76d2b2;--bad:#ff7a72;--gold:#e6c47b;--sea:#071b24}
*{box-sizing:border-box}body{margin:0;background:#031017;color:var(--ink);font:14px/1.45 ui-monospace,SFMono-Regular,Menlo,monospace}
main{max-width:1180px;margin:auto;padding:28px}.eyebrow{color:var(--gold);letter-spacing:.14em;text-transform:uppercase}h1{font:500 32px/1.1 Georgia,serif;margin:.3em 0}.sub{color:var(--muted);max-width:760px}
.metrics{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin:24px 0}.metric{border:1px solid #193944;background:#071820;padding:14px}.metric b{display:block;font-size:20px;color:var(--ink)}.metric span{color:var(--muted);font-size:11px;text-transform:uppercase}
.stage{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:18px}.panel{border:1px solid #193944;background:var(--sea);padding:14px}svg{width:100%;height:auto;display:block;background:radial-gradient(circle at 50% 45%,#0c3543,#061922 70%)}
.station{fill:var(--gold);stroke:#fff1bf;stroke-width:.6}.cable{stroke:#6fa2aa;stroke-width:1.2}.cable.broken{stroke:var(--bad);stroke-dasharray:2 2}.agent{stroke:#c7f3ed;stroke-width:.25}.agent.down{fill:#37464a}.partition{fill:#ff7a72;opacity:.18}.label{font-size:3px;fill:#c4d7d9}.status{font-size:18px}.ok{color:var(--ok)}.bad{color:var(--bad)}
.legend{color:var(--muted);font-size:12px}.legend div{margin:8px 0}.dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:8px}.timeline{display:grid;grid-template-columns:repeat(40,1fr);height:12px;margin:15px 0 4px}.timeline i{display:block}.controls{display:flex;gap:10px;align-items:center;margin-top:12px}.controls input{flex:1}.controls button{background:#102d37;color:var(--ink);border:1px solid #355860;padding:7px 12px}.small{color:var(--muted);font-size:11px}
@media(max-width:800px){.metrics{grid-template-columns:repeat(2,1fr)}.stage{grid-template-columns:1fr}}
</style>
</head>
<body><main>
<a href="/intelligence/swarm-lab/" style="color:var(--ok)">← Swarm Lab</a>
<div class="eyebrow">No leader, still alive</div><h1>TUNA Redux — Swarm / seed 42</h1>
<p class="sub">Follow 32 simulated subsea agents as they maintain links between four terminals. Press Play or scrub through the 40 ticks to see when service fails and recovers. Red gaps are outages; the radio graph is recomputed from physical proximity each tick.</p>
<section class="metrics">
<div class="metric"><b>80.00%</b><span>network uptime</span></div>
<div class="metric"><b>8.0</b><span>mean recovery ticks</span></div>
<div class="metric"><b>118.80</b><span>energy units</span></div>
<div class="metric"><b>2244</b><span>messages</span></div>
<div class="metric"><b>0</b><span>human escalations</span></div>
</section>
<section class="stage"><div class="panel">
<svg id="ocean" viewBox="0 0 100 100" role="img" aria-label="Subsea simulation map"></svg>
<div class="timeline" id="timeline"></div>
<div class="controls"><button id="play">Play</button><input id="tick" aria-label="Replay tick" type="range" min="0" max="39" value="0"><span id="tickLabel">t=0</span></div>
</div><aside class="panel">
<div id="status" class="status"></div><p id="detail" class="small"></p>
<div class="legend">
<div><span class="dot" style="background:#76d2b2"></span>hold / relay</div>
<div><span class="dot" style="background:#e6c47b"></span>repair</div>
<div><span class="dot" style="background:#7eb8ff"></span>move / recharge</div>
<div><span class="dot" style="background:#37464a"></span>failed / depleted</div>
<div>Gold diamonds are fixed terminals. Solid lines are live cables; dashed red lines are failed cables. A translucent red wall is a temporary communication partition.</div>
</div></aside></section>
</main>
