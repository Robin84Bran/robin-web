---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {experiments,VERSION} from '../../../../public/swarm-lab/lab.mjs';
import batchResults from '../../../../public/swarm-lab/results.json';
export function getStaticPaths(){return experiments.map(e=>({params:{experiment:e.id},props:{e}}));}
const {e}=Astro.props;
const batch=batchResults.experiments.find((x:{id:string})=>x.id===e.id)!;
const path=`/intelligence/swarm-lab/${e.id}/`,description=e.question+' '+e.limits;
const schema={'@context':'https://schema.org','@type':'LearningResource',name:e.title,description,url:`https://iamrobin.ai${path}`,inLanguage:'en',learningResourceType:'Interactive simulation',educationalUse:'Experiment',isAccessibleForFree:true};
const format=(v:number)=>e.id==='mars-jar'?v.toFixed(1)+' days':(v*100).toFixed(1)+'%';
const findings:Record<string,string>={
 'cell-city':'Shared founders sustain far more cooperation under these rules. But take away the public benefit and the story changes. Assortment is doing work here; the green dots are not better people.',
 'self-assembly':'Adhesion usually pulls more surviving particles into a connected group. It does not regrow the missing fourteen. Not every seed ends in a single cluster.',
 'mars-jar':'Maintenance reaches day 240 in every default run; no maintenance fails on day 109. The first result is censored at the observation limit—not a measured lifetime. Both arms lose material.',
 'memory-islands':'Skills help. Remembering failed actions helps further while rules stay fixed within an island. The advantage is a designed exclusion rule, not evidence of reflective consciousness.'};
---
<BaseLayout title={`${e.title} — Swarm Lab — Robin Xie`} {path} {description} {schema}>
 <div class="shell experiment">
  <a class="quiet-link" href="/intelligence/swarm-lab/">← Four small worlds</a>
  <p class="eyebrow">Swarm Lab · Experiment {e.number} · <span lang="zh-Hans">{e.chinese}</span></p>
  <h1>{e.title}</h1><p class="question">{e.question}</p><p class="hook">{e.hook}</p>
  <section class="bench" data-swarm-lab={e.id} aria-label="Interactive experiment">
   <div class="bench-heading"><h2>Make a prediction. Then press Play.</h2><span>Model {VERSION} · simulation only</span></div>
   <form class="controls">
    <label>Seed <input disabled data-param name="seed" type="number" min="0" max="4294967295" step="1" value="24" required /></label>
    <label class="slider">{e.control} <output>{e.initial}</output><input disabled data-param name={e.key} type="range" min={e.min} max={e.max} step={e.step} value={e.initial}/></label>
    {e.id==='cell-city'&&<label>Public benefit <select disabled data-param name="benefit"><option value="0">0 · no benefit</option><option value="1.6" selected>1.6 · default</option><option value="3">3 · high benefit</option></select></label>}
    {e.id==='self-assembly'&&<><label>Boundary <select disabled data-param name="boundary"><option value="dish">Round dish</option><option value="square">Square dish</option></select></label><label>Signal range <select disabled data-param name="range"><option value="0.12">0.12 · short</option><option value="0.22" selected>0.22 · default</option><option value="0.35">0.35 · wide</option></select></label><label class="check"><input disabled data-param name="damage" type="checkbox" checked/> Remove 14 at step 90</label></>}
    {e.id==='mars-jar'&&<><label>Starting stock <select disabled data-param name="stockScale"><option value="0.5">Half</option><option value="1" selected>Default</option><option value="3">Triple</option></select></label><label>Sunlight <select disabled data-param name="solar"><option value="0.5">Half</option><option value="1" selected>Default</option><option value="1.5">1.5×</option></select></label></>}
   </form>
   <div class="buttons"><button disabled type="button" data-play aria-pressed="false">Play</button><button disabled type="button" data-step>Step</button><button disabled type="button" data-reset>Reset</button><button disabled type="button" data-next>Next seed</button><button disabled type="button" data-share>Share this setup</button></div>
   <noscript><p>The controls need JavaScript. The tested batch, source code and methods below remain fully available.</p></noscript>
   <canvas aria-label={`${e.title}: matched simulation arms and trajectory chart. Current values follow below.`} role="img">Read the accessible values and batch results below.</canvas>
   <label class="scrub"><span data-time>Step 0</span><input disabled type="range" name="time" min="0" max="100" value="0" aria-label="Simulation time"/></label>
   <div data-readout class="readout" aria-label="Current simulation values"></div>
   <p class="legend">{e.legend} The dashed chart line is the first arm. Controls change both arms except the named treatment; the seed is shared.</p>
   <div class="buttons exports"><button disabled type="button" data-export="csv">Download chart CSV</button><button disabled type="button" data-export="json">Download full run JSON</button></div><p data-notice role="status" class="notice">Loading local simulation…</p>
  </section>
  <section class="try"><p class="eyebrow">Now break the story</p><h2>{e.ask}</h2><p>Move one control, keep the seed, and compare again. The batch below is a fixed baseline—not a live summary of your current settings.</p></section>
  {e.id==='mars-jar'&&<aside class="twist"><p class="eyebrow">A second test overturned the easy lesson</p><h2>Repair can spend tomorrow’s lunch.</h2><p>At half sunlight, the same maintenance policy shortens mean survival from <strong>49.88 to 46.53 days</strong> across 32 seeds. Repairs consume energy before recycling gets its share. The lesson is not “never repair.” It is that a fixed maintenance rule ignores what the system needs most right now.</p><a class="quiet-link" href="?seed=24&amp;leak=0.001&amp;stockScale=1&amp;solar=0.5&amp;v=1.0.0">Try half sunlight →</a><p class="small">Sensitivity test; all runs retained in <a href="/swarm-lab/results.json">the full batch JSON</a>.</p></aside>}
  <section aria-labelledby="batch-title"><p class="eyebrow">Observed in this model · 32 matched seeds · all runs retained</p><h2 id="batch-title">A result, not just an animation.</h2><p class="finding">{findings[e.id]}</p>
   <div class="table-wrap"><table><caption>Default settings · seeds 1–32 · final {e.id==='mars-jar'?'observed completed days':e.unit}</caption><thead><tr><th scope="col">Arm</th><th scope="col">Mean</th><th scope="col">Seed range</th></tr></thead><tbody>{batch.arms.map((a:{label:string;mean:number;min:number;max:number})=><tr><th scope="row">{a.label}</th><td>{format(a.mean)}</td><td>{format(a.min)} – {format(a.max)}</td></tr>)}</tbody></table></div>
   <p class="small">Ranges describe these runs, not confidence intervals for real-world systems. {e.id==='mars-jar'?'240 days is the observation ceiling; the maintained arm’s lifespan is not established.':''}</p>
   <p class="evidence"><a href={`/swarm-lab/${e.folder}/results.csv`}>Every seed · CSV</a> · <a href={`/swarm-lab/${e.folder}/results.json`}>Parameters &amp; summaries · JSON</a></p>
  </section>
  <section class="methods"><details><summary>Under the hood · the actual rules</summary><p>{e.mechanism}</p><p><a href={`/swarm-lab/${e.folder}/model.mjs`}>Read this model’s source</a> · <a href="/swarm-lab/tests.mjs">Read invariant tests</a> · <a href="/swarm-lab/verify.mjs">Reproduce the receipts</a></p></details><details open><summary>Where the analogy stops</summary><p>{e.limits}</p></details><details><summary>Sources, methods &amp; reproduction</summary><p>Inspired by <a href="/meaning/diary/202609/2026-09-24-from-art-to-immortal-cells/">Robin’s diary</a>. Background: <a href={e.source}>{e.sourceTitle}</a>. This is an original teaching model, not a replication of that research.</p><p><a href={`/swarm-lab/${e.folder}/README.md`}>Experiment notes</a> · <a href="/swarm-lab/README.md">Run locally with Node</a> · <a href="/swarm-lab/results.json">Version &amp; source hashes</a></p></details></section>
  <nav class="other-worlds" aria-label="Other experiments">{experiments.filter(x=>x.id!==e.id).map(x=><a href={`/intelligence/swarm-lab/${x.id}/`}>{x.number} · {x.title} →</a>)}</nav>
 </div>
 <script is:inline type="module" src="/swarm-lab/ui.mjs"></script>
</BaseLayout>
<style>
 .twist{padding:1.5rem 2rem;background:#e8e1d3;border-left:2px solid #a67c48;margin-bottom:3rem}.twist>p{line-height:1.8;max-width:50rem}.twist h2{margin-top:.7rem}
 .experiment{padding-block:3rem 5rem}.experiment>.eyebrow{margin-top:3rem}.experiment h1{font-family:var(--serif);font-size:clamp(2.7rem,6vw,5rem);line-height:1.08;font-weight:400;letter-spacing:-.04em;max-width:54rem;margin:1.3rem 0}.question{font-family:var(--serif);font-size:clamp(1.3rem,3vw,2rem);color:#59736a}.hook{max-width:47rem;color:var(--muted);line-height:1.8;margin-bottom:2.7rem}h2{font-family:var(--serif);font-size:clamp(1.5rem,3vw,2.5rem);font-weight:400;line-height:1.25}.bench{background:#f0eee5;border:1px solid #d5d1c2;padding:clamp(1rem,3vw,2rem);border-radius:3px}.bench-heading{display:flex;align-items:center;gap:1rem;flex-wrap:wrap;justify-content:space-between;margin-bottom:1.5rem}.bench-heading h2{font-size:1.5rem;margin:0}.bench-heading span,.small,.notice,.legend{font-size:.8rem;line-height:1.7;color:var(--muted)}.controls{display:flex;flex-wrap:wrap;gap:1rem 1.7rem;align-items:end}.controls label{display:grid;gap:.4rem;font-size:.8rem}.controls input[type=number]{width:7.5rem}.controls input,.controls select{background:#faf9f3;color:#373c33;border:1px solid #c2bca9;padding:.5rem;font:inherit;min-height:40px;border-radius:2px}.controls .slider{grid-template-columns:1fr auto;min-width:170px;flex:1;max-width:300px}.slider input{grid-column:1/-1;width:100%;accent-color:#59736a;padding:0}.controls .check{display:flex;align-items:center;gap:.5rem}.check input{width:18px;min-height:18px;accent-color:#59736a}.buttons{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:1.5rem}.buttons button{font:inherit;font-size:.8rem;padding:.6rem .9rem;min-height:44px;border:1px solid #b4b6a7;background:transparent;color:#3f5148;border-radius:2px;cursor:pointer}.buttons [data-play]{background:#526d60;color:white;border-color:#526d60;min-width:80px}.buttons button:hover{border-color:#526d60;background:#e1e5d8}.buttons [data-play]:hover{background:#3d5448}button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:2px solid #ad6c47;outline-offset:3px}button:disabled{opacity:.5;cursor:wait}canvas{width:100%;display:block;margin-top:1rem}.scrub{display:flex;gap:1rem;align-items:center;font-size:.8rem}.scrub input{flex:1;min-width:0;accent-color:#59736a;min-height:44px}.readout{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:.6rem;font-size:.83rem;line-height:1.6}.readout :global(p){margin:.8rem 0}.legend{margin:.5rem 0}.exports button{font-size:.72rem}.notice{min-height:1.7rem;margin:.7rem 0 0}.try{margin-block:3rem;padding-block:2rem;border-block:1px solid var(--line)}.try h2{max-width:52rem}.try p:not(.eyebrow),.finding{max-width:50rem;line-height:1.8;color:var(--muted)}.table-wrap{overflow:auto;margin-top:1.5rem}table{width:100%;border-collapse:collapse;font-size:.9rem}caption{text-align:left;font-size:.8rem;margin-bottom:1rem;color:var(--muted)}th,td{padding:1rem .7rem;border-bottom:1px solid var(--line);text-align:left}th{font-weight:500}.evidence{font-size:.8rem;line-height:2}.methods{margin-top:3rem}.methods details{border-top:1px solid var(--line);padding:1.2rem 0}.methods summary{cursor:pointer;font-size:1rem}.methods p{max-width:54rem;line-height:1.85;font-size:.9rem;color:var(--muted)}.other-worlds{display:flex;flex-wrap:wrap;gap:1rem 2rem;border-top:1px solid var(--line);padding-top:2rem;margin-top:2rem;font-size:.8rem}@media(max-width:600px){.bench{margin-inline:-.5rem}.experiment>.eyebrow{font-size:.67rem}th,td{padding:.8rem .35rem;font-size:.78rem}.controls{gap:1rem}.readout{grid-template-columns:1fr;gap:0}.bench-heading span{font-size:.7rem}}
</style>
