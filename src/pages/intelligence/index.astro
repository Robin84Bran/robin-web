---
import BaseLayout from '../../layouts/BaseLayout.astro';
import programme from '../../data/research-programme.json';
const { guides, fields } = programme;
const experiments = [...programme.experiments].sort((a,b)=>b.week.localeCompare(a.week));
const councils = [...programme.councils].sort((a,b)=>b.date.localeCompare(a.date));
const featured = experiments[0];
const path = '/intelligence/';
const description = 'A playable window into our research. Explore weekly experiments, join an Open Council, or learn through visual field guides.';
const schema = {'@context':'https://schema.org','@type':'CollectionPage',name:'Intelligence — Robin Xie',url:`https://iamrobin.ai${path}`,description,inLanguage:'en',hasPart:experiments.map(e=>({'@type':'LearningResource',name:e.title,url:`https://iamrobin.ai/intelligence/${e.id}/`}))};
---
<BaseLayout title="Intelligence — Robin Xie" {path} {description} {schema}>
  <main class="shell library">
    <header class="library-heading">
      <p class="eyebrow">07 / 08 · The playable library</p>
      <h1>Intelligence</h1>
      <p class="subtitle">A playable window into our research.</p>
      <span class="watermark" aria-hidden="true">I</span>
    </header>
    <div class="library-grid">
      <aside class="library-index">
        <p class="eyebrow">Find your way</p>
        <nav aria-label="Intelligence sections">
          <a href="#experiments"><small>01 · Play</small>Experiments</a>
          <a href="#open-council"><small>02 · Discuss</small>Open Council</a>
          <a href="#field-guides"><small>03 · Learn</small>Field Guides</a>
        </nav>
        <a class="programme-link" href="/research/">Explore the Research<br />programme →</a>
      </aside>
      <div class="library-body">
        <nav class="reading-path" aria-label="Ways into Intelligence"><a href="#experiments">Try a rule</a><a href="#open-council">Challenge an idea</a><a href="#field-guides">Understand a mechanism</a></nav>
        <section id="experiments" aria-labelledby="experiments-title">
          <div class="section-heading"><h2 id="experiments-title">Experiments</h2><span>01 · Play</span></div>
          <article class="featured-experiment">
            <div><p class="eyebrow">This week · {featured.week}</p><h3>{featured.title}</h3><p>{featured.question}</p><a class="text-link" href={`/intelligence/${featured.id}/`}>Play the experiment →</a></div>
            <img src="/programme/work-or-proof.webp" alt="" width="440" height="294" fetchpriority="high" />
          </article>
          <ol class="experiment-list" aria-label="All weekly experiments">
            {experiments.map(e=><li data-weekly-experiment={e.id}><a class="experiment-row" href={`/intelligence/${e.id}/`}><span class="week">{e.week.replace(/^\d{4}-/,'')}</span><span class="experiment-name">{e.title}{e.maturity!=='Playable seed'&&<small class="badge">{e.maturity}</small>}</span><span class="question">{e.question}</span><span class="enter" aria-hidden="true">→</span></a></li>)}
          </ol>
          <div class="lab-links"><span class="eyebrow">Keep exploring</span><a href="/intelligence/swarm-lab/">Swarm Lab · Eight Small Worlds →</a><a href="/intelligence/agent-swarm/">Agent Swarm Lab · Six worlds →</a></div>
        </section>
        <section id="open-council" aria-labelledby="council-title">
          <div class="section-heading"><h2 id="council-title">Open Council</h2><span>02 · Discuss</span></div>
          <p class="section-intro">Choose a position. Challenge a motion. Leave the question open.</p>
          <ol class="council-list">{councils.map(c=><li><a href={`/intelligence/council/${c.slug}/`}><time datetime={c.date}>{c.displayDate}</time><h3>{c.title}</h3><span aria-hidden="true">→</span></a></li>)}</ol>
        </section>
        <section id="field-guides" aria-labelledby="guides-title">
          <div class="section-heading"><h2 id="guides-title">Field Guides</h2><span>03 · Learn</span></div>
          <div class="guide-grid">{guides.map(g=><a class="guide" href={g.href}><p class="eyebrow">{g.kind}</p><h3>{g.title}</h3><p>{g.question}</p><span class="text-link">Explore the guide →</span></a>)}</div>
          <nav class="field-links" aria-label="More visual explanations">{fields.map(f=><a href={f.href}>{f.title} →</a>)}</nav>
        </section>
      </div>
    </div>
    <nav class="directory-cycle" aria-label="Identity directories"><a href="/binary/">← Binary</a><a href="/network/">Network →</a></nav>
  </main>
</BaseLayout>
<style>
.library{padding-block:3rem 4rem}.library-heading{position:relative;border-bottom:1px solid var(--line);padding-bottom:1.8rem;overflow:hidden}.library-heading h1{font:400 clamp(3.6rem,8vw,6.5rem)/1.04 var(--serif);letter-spacing:-.045em;margin:.8rem 0 .4rem}.subtitle{font:italic 1.55rem/1.5 var(--serif);color:var(--muted);margin:0}.watermark{position:absolute;right:1.5rem;top:-3rem;font:400 15rem/1 var(--serif);color:var(--sakura);opacity:.24;pointer-events:none}.library-grid{display:grid;grid-template-columns:13rem minmax(0,1fr);gap:2.8rem;margin-top:2.4rem}.library-index{align-self:start;position:sticky;top:2rem;border-right:1px solid var(--line);padding-right:1.7rem}.library-index nav{display:grid;gap:1.2rem;margin-top:1.8rem}.library-index nav a{text-decoration:none;font:400 1.55rem/1.2 var(--serif)}.library-index small{display:block;font:500 .63rem/1.5 var(--sans);text-transform:uppercase;letter-spacing:.12em;color:var(--muted);margin-bottom:.25rem}.programme-link{display:block;border-top:1px solid var(--line);padding-top:1.4rem;margin-top:2rem;text-decoration:none;font:400 1.05rem/1.6 var(--serif);color:#42665b}.reading-path{display:flex;justify-content:space-between;gap:1rem;padding:.4rem 0 1.4rem;border-bottom:1px solid var(--line);margin-bottom:1.6rem}.reading-path a{color:#42665b;text-decoration:none;font:italic 1.07rem/1.4 var(--serif)}section{scroll-margin-top:1.5rem}.section-heading{display:flex;gap:1rem;align-items:baseline;justify-content:space-between}.section-heading h2{font:600 .8rem/1.5 var(--sans);letter-spacing:.16em;text-transform:uppercase;color:var(--gold-dark);margin:0}.section-heading>span{font-size:.66rem;color:var(--muted);letter-spacing:.1em;text-transform:uppercase}.featured-experiment{display:grid;grid-template-columns:minmax(0,1fr) 28%;gap:1.5rem;align-items:center;padding:1.3rem 0 1.7rem}.featured-experiment h3{font:400 clamp(2rem,4vw,3.3rem)/1.1 var(--serif);letter-spacing:-.035em;margin:.35rem 0 .5rem}.featured-experiment p:not(.eyebrow){font:italic 1.23rem/1.5 var(--serif);max-width:30rem;margin-bottom:1rem}.featured-experiment .eyebrow{font-size:.6rem;color:var(--muted);margin:0}.featured-experiment img{width:100%;height:auto;mix-blend-mode:multiply}.text-link{font:400 1.05rem/1.5 var(--serif);color:#42665b;text-decoration:none;border-bottom:1px solid #42665b55;padding-bottom:.15rem}.experiment-list,.council-list{list-style:none;margin:0;padding:0}.experiment-row{display:grid;grid-template-columns:2.2rem minmax(12rem,.9fr) minmax(0,1fr) 1rem;gap:1rem;align-items:center;padding:1rem 0;border-top:1px solid var(--line);text-decoration:none}.week{color:var(--gold-dark);font:500 .62rem/1.5 var(--sans);letter-spacing:.03em}.experiment-name{font:400 1.35rem/1.2 var(--serif);letter-spacing:-.015em}.question{font:.9rem/1.55 var(--sans);color:var(--muted);padding-left:1rem;border-left:1px solid var(--line)}.enter{color:#42665b}.badge{display:block;width:fit-content;color:var(--gold-dark);font:500 .57rem/1.5 var(--sans);letter-spacing:.09em;text-transform:uppercase;margin-top:.35rem}.lab-links{display:flex;flex-wrap:wrap;gap:.5rem 1.5rem;padding:1.25rem 0;border-block:1px solid var(--line)}.lab-links .eyebrow{font-size:.6rem;margin:0}.lab-links a{font:400 .9rem/1.5 var(--serif);text-decoration:none;color:#42665b}#open-council,#field-guides{margin-top:2.5rem}.section-intro{font:.86rem/1.6 var(--sans);color:var(--muted);margin:.7rem 0 1rem}.council-list a{display:grid;grid-template-columns:6.6rem minmax(0,1fr) 1rem;gap:1rem;align-items:baseline;text-decoration:none;padding:1.1rem 0;border-top:1px solid var(--line)}.council-list h3{font:400 1.45rem/1.25 var(--serif);margin:0}.council-list time{font:.66rem/1.5 var(--sans);color:var(--muted)}.council-list a>span{color:#42665b}.guide-grid{display:grid;grid-template-columns:1fr 1fr;gap:2rem;margin-top:1.3rem}.guide{text-decoration:none;padding:1.2rem 0;border-top:1px solid var(--line);display:flex;flex-direction:column;align-items:start}.guide+.guide{border-left:1px solid var(--line);padding-left:2rem}.guide h3{font:400 1.6rem/1.2 var(--serif);margin:.2rem 0 .8rem}.guide .eyebrow{font-size:.6rem}.guide>p:not(.eyebrow){font:.85rem/1.6 var(--sans);color:var(--muted);margin-bottom:1rem}.guide .text-link{margin-top:auto;font-size:.95rem}.field-links{display:flex;flex-wrap:wrap;gap:1.5rem;border-top:1px solid var(--line);padding-top:1rem}.field-links a{font:.75rem/1.5 var(--sans);text-decoration:none;color:var(--muted)}.directory-cycle{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding-top:1.5rem;margin-top:3rem;font:.8rem/1.5 var(--sans)}a:hover{text-decoration:underline;text-underline-offset:.25em}
@media(max-width:1000px){.library-grid{grid-template-columns:10rem minmax(0,1fr);gap:1.7rem}.library-index nav a{font-size:1.3rem}.experiment-row{grid-template-columns:2rem minmax(9rem,1fr) minmax(0,1.2fr) .7rem;gap:.7rem}.experiment-name{font-size:1.2rem}.question{font-size:.75rem;padding-left:.7rem}.reading-path a{font-size:.95rem}}
@media(max-width:720px){.library{padding-top:1.8rem}.library-heading h1{font-size:3.4rem}.subtitle{font-size:1.25rem}.watermark{font-size:10rem;top:-1rem}.library-grid{display:block;margin-top:1.5rem}.library-index{position:static;border:0;padding:0;margin-bottom:1.7rem}.library-index>.eyebrow{display:none}.library-index nav{display:flex;gap:1.3rem;justify-content:space-between;margin:0}.library-index nav a{font-size:1.07rem}.library-index small{font-size:.56rem}.programme-link{font:.88rem/1.4 var(--serif);margin-top:1rem;padding-top:.8rem}.programme-link br{display:none}.reading-path{display:none}.featured-experiment{grid-template-columns:1fr 26%;gap:.6rem}.featured-experiment h3{font-size:2.2rem}.featured-experiment p:not(.eyebrow){font-size:1.05rem}.experiment-row{grid-template-columns:2.1rem 1fr 1rem;gap:.5rem;padding:.9rem 0}.experiment-name{font-size:1.3rem}.question{grid-column:2;grid-row:2;border:0;padding:0;font-size:.79rem}.enter{grid-column:3;grid-row:1}.week{grid-row:1}.council-list a{grid-template-columns:1fr 1rem;gap:.3rem}.council-list time{grid-column:1}.council-list h3{grid-column:1;font-size:1.35rem}.council-list a>span{grid-column:2;grid-row:2}.guide-grid{gap:1rem}.guide+.guide{padding-left:1rem}.guide h3{font-size:1.35rem}.guide .text-link{font-size:.87rem}.section-heading>span{font-size:.59rem}.field-links{gap:.7rem 1rem}}
</style>
