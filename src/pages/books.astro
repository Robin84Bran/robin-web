---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageLead from '../components/PageLead.astro';
import BookTable from '../components/BookTable.astro';
import { createBooksSchemas } from '../lib/seo';
---

<BaseLayout
  title="Books — Robin Xie"
  description="Four living books by Robin Xie, presented as objects and questions."
  path="/books/"
  image="/books/agi-awakening.webp"
  imageAlt="Covers from Robin Xie's four living books"
  imageWidth={760}
  imageHeight={1140}
  schema={createBooksSchemas()}
>
  <PageLead eyebrow="Books / living manuscripts" title="Four books. Four questions." line="Pick up the one that looks back." />
  <div class="shell books-canvas">
    <BookTable />
  </div>
</BaseLayout>
