---
import BaseLayout from '../layouts/BaseLayout.astro';
import IdentityGarden from '../components/IdentityGarden.astro';
import IdentityBridge from '../components/IdentityBridge.astro';
import IdentityLanguageNav from '../components/IdentityLanguageNav.astro';
import { identityHomeAlternates, identityProfiles } from '../data/identity';
import { createHomeSchemas } from '../lib/seo';

const identity = identityProfiles.en;
---

<BaseLayout
  title={identity.title}
  description={identity.description}
  path="/"
  alternates={identityHomeAlternates}
  schema={createHomeSchemas()}
>
  <section class="zen-home shell" aria-labelledby="zen-home-title">
    <header class="zen-name">
      <p class="eyebrow">Professional Engineer · Accredited Investor · AI-Native System Builder</p>
      <h1 id="zen-home-title"><span>Ms.</span> Robin Xie<small>谢玢 · 謝玢</small></h1>
      <div class="zen-name__mobile-discovery">
        <a class="quiet-link" href={identity.aboutPath}>{identity.aboutLinkLabel}<span aria-hidden="true">↗</span></a>
        <IdentityLanguageNav currentLocale="en" page="home" />
      </div>
    </header>

    <figure class="time-portrait">
      <img src="/photos/hero-watch.jpg" alt="Robin pictured inside a watch face" width="829" height="1122" />
      <span class="time-portrait__orbit time-portrait__orbit--one" aria-hidden="true"></span>
      <span class="time-portrait__orbit time-portrait__orbit--two" aria-hidden="true"></span>
      <figcaption><span>Time is a loop.</span><small>HK ↔ US</small></figcaption>
    </figure>

    <span class="zen-axis" aria-hidden="true"></span>
    <div class="zen-garden"><IdentityGarden /></div>

    <p class="zen-mantra">I seek. <span>I become.</span> I AM.</p>
    <nav class="zen-portals" aria-label="Continue exploring">
      <a href="/about/">About</a>
      <span aria-hidden="true">·</span>
      <a href="/portfolio/">Portfolio</a>
      <span aria-hidden="true">·</span>
      <a href="/books/">Books</a>
    </nav>
    <p class="zen-side-note" aria-hidden="true">AMERICAN FRONTIER MIND · JAPANESE ZEN SURFACE</p>
  </section>
  <IdentityBridge />
</BaseLayout>
