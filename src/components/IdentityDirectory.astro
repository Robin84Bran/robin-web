---
import PublicationCalendar from './PublicationCalendar.astro';
import BookTable from './BookTable.astro';
import GravityField from './GravityField.astro';
import { portfolioDescription } from '../data/identityConnections';
import BaseLayout from '../layouts/BaseLayout.astro';
import { identityWords, pressLinks } from '../data/site';
import { getCollection } from 'astro:content';
import { createBreadcrumbSchema, createPersonSchema } from '../lib/seo';
import { actionFlows } from '../lib/actionFlows';
import { blogArchiveStatus, blogTitle } from '../lib/blogPresentation';

interface Props {
  entry: (typeof identityWords)[number];
  index: number;
  previous: (typeof identityWords)[number];
  next: (typeof identityWords)[number];
}

const { entry, index, previous, next } = Astro.props;
const isPressDirectory = entry.slug === 'network';
const isOuroborosDirectory = entry.slug === 'ouroboros';
const isBinaryDirectory = entry.slug === 'binary';
const isAsymmetryDirectory = entry.slug === 'asymmetry';
const isMeaningDirectory = entry.slug === 'meaning';
const briefings = isOuroborosDirectory
  ? (await getCollection('dailyBriefing', ({ data }) => !data.draft)).sort(
      (a, b) => b.data.date.getTime() - a.data.date.getTime(),
    )
  : [];
const actionItems = isOuroborosDirectory
  ? (await getCollection('actionItem', ({ data }) => !data.draft)).sort(
      (a, b) => b.data.date.getTime() - a.data.date.getTime(),
    )
  : [];
const blogEntries = isBinaryDirectory
  ? (await getCollection('blog', ({ data }) => !data.draft)).sort(
      (a, b) => b.data.date.getTime() - a.data.date.getTime(),
    )
  : [];
const specialEntries = isOuroborosDirectory
  ? (await getCollection('dailySpecial', ({ data }) => !data.draft && data.inLanguage === 'en'))
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || Number(Boolean(b.data.editionSlug)) - Number(Boolean(a.data.editionSlug)))
  : [];
const binaryStories = isBinaryDirectory
  ? (await getCollection('binaryStory', ({data})=>!data.draft && data.inLanguage==='en')).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime())
  : [];
const blogLanes = [
  { key: 'BUILD', name: 'Build', cadence: 'Systems into reality' },
  { key: 'INVEST', name: 'Invest', cadence: 'Signals into judgment' },
  { key: 'JOY', name: 'Joy', cadence: 'Curiosity into meaning' },
] as const;
const diaryEntries = isMeaningDirectory
  ? (await getCollection('diary', ({ data }) => !data.draft && (!data.originalLanguage || data.inLanguage === data.originalLanguage))).sort(
      (a, b) => b.data.date.getTime() - a.data.date.getTime(),
    )
  : [];

const compactDate = (date: Date) => date.toISOString().slice(0, 10).replaceAll('-', '');
const displayDate = (date: Date) => date.toLocaleDateString('en-US', {
  timeZone: 'UTC', month: 'long', day: 'numeric', year: 'numeric',
});
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
const ouroborosLanes = [
  {key:'briefing', name:'Daily Briefing', line:'Signals in motion.', id:'daily-briefing'},
  {key:'action', name:'Daily Action Flow', line:'Signal into execution.', id:'daily-action-flow'},
  {key:'special', name:'Daily Special', line:'A closer look.', id:'daily-special'},
];
const ouroborosCalendar = [
  ...briefings.map(item=>{const d=compactDate(item.data.date);return {date:isoDate(item.data.date),title:'Daily Briefing',href:`/ouroboros/${d.slice(0,6)}/${d}/`,lane:'briefing'};}),
  ...actionFlows.map(flow=>{const d=flow.date.replaceAll('-','');return {date:flow.date,title:`${flow.signalCount} signals · Daily Action Flow`,href:`/ouroboros/${d.slice(0,6)}/${d}/actions/`,lane:'action'};}),
  ...actionItems.map(item=>{const d=compactDate(item.data.date);return {date:isoDate(item.data.date),title:item.data.title,href:`/ouroboros/${d.slice(0,6)}/${d}/action_item/`,lane:'action'};}),
  ...specialEntries.map(item=>({date:isoDate(item.data.date),title:item.data.title,href:new URL(item.data.canonical).pathname,lane:'special'})),
];
const binaryLanes=blogLanes.map(l=>({key:l.key,name:l.name,line:l.cadence,id:`binary-lane-${l.key.toLowerCase()}`}));
const binaryCalendar=[
 ...blogEntries.filter(item=>blogArchiveStatus(item.data.date)==='PRESENT').map(item=>{const d=compactDate(item.data.date);return {date:isoDate(item.data.date),title:blogTitle(item.data.date,'en',item.data.title),href:`/ouroboros/${d.slice(0,6)}/${d}/blog/`,lane:item.data.lane};}),
 ...binaryStories.map(item=>({date:isoDate(item.data.date),title:item.data.title,href:new URL(item.data.canonical).pathname,lane:item.data.lane})),
];
const path = `/${entry.slug}/`;
const ouroborosSchemas = isOuroborosDirectory
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        '@id': 'https://iamrobin.ai/ouroboros/#archive',
        name: 'Ouroboros — Robin Xie',
        description: 'Robin Xie’s Daily Briefings, Daily Action Flows, Signal 5 deep dives, and selected Daily Special research.',
        url: 'https://iamrobin.ai/ouroboros/',
        inLanguage: 'en',
        author: { '@id': 'https://www.tideisun.com/robin#robin-xie' },
      },
      createPersonSchema(),
      createBreadcrumbSchema([
        { name: 'Home', path: '/' },
        { name: 'Ouroboros', path: '/ouroboros/' },
      ]),
    ]
  : undefined;
const binarySchemas = isBinaryDirectory
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        '@id': 'https://iamrobin.ai/binary/#blog',
        name: 'Binary · Blog — Robin Xie',
        description: 'Robin Xie’s Build, Invest, and Joy stories, growing from research and experiments.',
        url: 'https://iamrobin.ai/binary/',
        inLanguage: 'en',
        author: { '@id': 'https://www.tideisun.com/robin#robin-xie' },
      },
      createPersonSchema(),
      createBreadcrumbSchema([
        { name: 'Home', path: '/' },
        { name: 'Binary', path: '/binary/' },
      ]),
    ]
  : undefined;
const meaningSchemas = isMeaningDirectory
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        '@id': 'https://iamrobin.ai/meaning/#diary',
        name: 'Meaning · Diary, Books & Portfolio — Robin Xie',
        description: 'Diary, Bran Lab, four living books and an attention-field portfolio by Robin Xie.',
        url: 'https://iamrobin.ai/meaning/',
        inLanguage: 'und',
        author: { '@id': 'https://www.tideisun.com/robin#robin-xie' },
      },
      createPersonSchema(),
      createBreadcrumbSchema([
        { name: 'Home', path: '/' },
        { name: 'Meaning', path: '/meaning/' },
      ]),
    ]
  : undefined;
---

<BaseLayout
  title={`${entry.word} — I AM ROBIN`}
  description={isOuroborosDirectory
    ? 'Daily Briefings, Daily Action Flows, Signal 5 deep dives, and selected Daily Special research by Robin Xie.'
    : isBinaryDirectory
      ? 'Build, Invest, and Joy essays by Robin Xie.'
    : isMeaningDirectory
      ? 'Diary, Bran Lab, four living books and an attention-field portfolio by Robin Xie.'
    : `${entry.word}: a living project directory inside the I AM ROBIN identity map.`}
  {path}
  noindex={!isOuroborosDirectory && !isBinaryDirectory && !isMeaningDirectory}
  schema={ouroborosSchemas ?? binarySchemas ?? meaningSchemas}
>
  <section class:list={['identity-directory', { 'identity-directory--library': isOuroborosDirectory || isBinaryDirectory || isMeaningDirectory }, 'shell']}>
    <a class="directory-back" href="/">← I AM ROBIN</a>
    <div class={`directory-letter directory-letter--${entry.tone}`} aria-hidden="true">{entry.letter}</div>
    <p class="eyebrow">{String(index + 1).padStart(2, '0')} / 08 · project directory</p>
    <h1>{entry.word}</h1>
    {
      isOuroborosDirectory ? (
        <PublicationCalendar entries={ouroborosCalendar} lanes={ouroborosLanes} name="Ouroboros" />
      ) : isBinaryDirectory ? (
        <>
          <PublicationCalendar entries={binaryCalendar} lanes={binaryLanes} name="Binary" />
          <details class="binary-future"><summary>On the horizon · editorial pipeline</summary>
            {blogLanes.map(lane=><details class="binary-pipeline"><summary>{lane.name}</summary><nav aria-label={`${lane.name} pipeline`}>
              {blogEntries.filter(item=>item.data.lane===lane.key && blogArchiveStatus(item.data.date)==='PIPELINE').map(item=>{const d=compactDate(item.data.date);return <a href={`/ouroboros/${d.slice(0,6)}/${d}/blog/`}><time datetime={isoDate(item.data.date)}>{displayDate(item.data.date)}</time> {blogTitle(item.data.date,'en',item.data.title)} →</a>;})}
            </nav></details>)}
          </details>
          <section class="binary-play" id="play" aria-labelledby="binary-play-title"><a href="/binary/coevolution/"><small>04</small><h2 id="binary-play-title">Play</h2><span aria-hidden="true">↗</span></a><p><a href="/binary/coevolution/">The Second Hand</a> · Weekly short plays on human–AI coevolution.</p></section>
        </>
      ) : isMeaningDirectory ? (
        <>
        <section class="diary-library" id="diary" aria-labelledby="diary-library-title">
          <div class="diary-library__heading">
            <span>01</span>
            <h2 id="diary-library-title">Diary</h2>
            <em>as it was written</em>
          </div>
          {diaryEntries.length ? (
            <nav aria-label="Diary archive">
              {diaryEntries.map((diary) => {
                const date = compactDate(diary.data.date);
                return (
                  <a href={`/meaning/diary/${date.slice(0, 6)}/${diary.id.split('/')[0]}/`}>
                    <time datetime={diary.data.date.toISOString().slice(0, 10)}>{displayDate(diary.data.date)}</time>
                    <strong>{diary.data.title}</strong>
                    <span aria-hidden="true">→</span>
                  </a>
                );
              })}
            </nav>
          ) : (
            <p class="diary-library__empty">A note will appear when it asks to be kept.</p>
          )}
        </section>
        <section class="diary-library" id="bran-lab" aria-labelledby="bran-lab-title">
          <div class="diary-library__heading">
            <span>02</span>
            <h2 id="bran-lab-title">Bran_lab</h2>
            <em>for the joy of “what if?”</em>
          </div>
          <nav aria-label="Bran Lab arcade">
            <a href="/meaning/Bran_lab/">
              <small>9 mini-games</small>
              <strong>Build, explore, race, and discover math in 3D</strong>
              <span aria-hidden="true">→</span>
            </a>
          </nav>
        </section>
        <section class="meaning-collection" id="books" aria-labelledby="meaning-books-title">
          <header><span>03</span><h2 id="meaning-books-title">Books</h2></header>
          <p class="collection-title">Four books. Four questions.</p><p>Pick up the one that looks back.</p>
          <div class="books-canvas"><BookTable /></div>
          <p><a href="/books/">Open the Books room →</a></p>
        </section>
        <section class="meaning-collection" id="portfolio" aria-labelledby="meaning-portfolio-title">
          <header><span>04</span><h2 id="meaning-portfolio-title">Portfolio</h2></header>
          <p class="collection-title">Capital follows attention.</p><p>{portfolioDescription}</p>
          <div class="portfolio-canvas"><GravityField /></div>
          <p><a href="/portfolio/">Open the Portfolio room →</a></p>
        </section>
        </>
      ) : isPressDirectory ? (
        <section class="press-directory" aria-labelledby="press-directory-title">
          <h2 id="press-directory-title">Press</h2>
          <nav aria-label="Selected press">
            {pressLinks.map((item) => (
              <a href={item.href} rel="noreferrer" target="_blank">
                <small>{item.source}</small>
                <strong>{item.label}</strong>
                <span aria-hidden="true">↗</span>
              </a>
            ))}
          </nav>
        </section>
      ) : isAsymmetryDirectory ? (
        <>
          <p class="asymmetry-intro">Capital simulations and model comparisons. Research only; human judgment remains in the loop.</p>
          <div class="asymmetry-categories">
            <section>
              <h2>Equities</h2>
              <ul>
                <li><span></span><a href="/asymmetry/black-friday-selloff/">Black Friday Selloff →</a></li>
                <li><span></span><a href="/asymmetry/hkipoblindbox/">The HK IPO Blind Box →</a></li>
              </ul>
            </section>
            <section>
              <h2>Crypto</h2>
              <ul>
                <li><span></span><a href="/asymmetry/flash-crash-lab/">Flash Crash Lab →</a></li>
                <li><span></span><a href="/asymmetry/model-olympics/">Model Olympics →</a></li>
                <li><span></span><a href="/asymmetry/btc_probability_atlas/">BTC Probability Atlas →</a></li>
                <li><span></span><a href="/asymmetry/quant_lab/">Quant Screener →</a></li>
              </ul>
            </section>
            <section><h2>Seed</h2></section>
          </div>
        </>
      ) : (
        <ul>
          {entry.projects.map((project) => <li><span></span>{project}</li>)}
          <li class="directory-future"><span></span>more, as it becomes</li>
        </ul>
      )
    }
    <nav class="directory-cycle" aria-label="Identity directories">
      <a href={`/${previous.slug}/`}>← {previous.word}</a>
      <a href={`/${next.slug}/`}>{next.word} →</a>
    </nav>
  </section>
</BaseLayout>
<style is:global>
  .asymmetry-intro { max-width: 48rem; color: var(--muted); line-height: 1.6; }
  .asymmetry-categories section { margin-block: 2.2rem; }
  .asymmetry-categories h2 { font: 2rem var(--serif); margin: 0 0 .65rem; }
  .asymmetry-categories section ul { margin-block: 0; }

  .binary-future {margin-top:1.5rem;font-size:.8rem;color:var(--muted);}
  .binary-future summary {cursor:pointer;padding:.8rem 0;} .binary-future nav a {display:block;padding:.7rem 0;}
  .special-empty { max-width: 44rem; margin: 0; padding: 1.2rem 0 1.8rem; color: var(--muted); font-size: .88rem; line-height: 1.7; }
</style>
