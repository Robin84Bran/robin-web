---
import BaseLayout from '../layouts/BaseLayout.astro';
import { identityWords, pressLinks } from '../data/site';
import { getCollection } from 'astro:content';
import { createBreadcrumbSchema, createPersonSchema } from '../lib/seo';
import { actionFlows } from '../lib/actionFlows';
import { blogArchiveStatus, blogTitle } from '../lib/blogPresentation';

interface Props {
  entry: (typeof identityWords)[number];
  index: number;
  previous: (typeof identityWords)[number];
  next: (typeof identityWords)[number];
}

const { entry, index, previous, next } = Astro.props;
const isPressDirectory = entry.slug === 'network';
const isOuroborosDirectory = entry.slug === 'ouroboros';
const isBinaryDirectory = entry.slug === 'binary';
const isMeaningDirectory = entry.slug === 'meaning';
const briefings = isOuroborosDirectory
  ? (await getCollection('dailyBriefing', ({ data }) => !data.draft)).sort(
      (a, b) => b.data.date.getTime() - a.data.date.getTime(),
    )
  : [];
const actionItems = isOuroborosDirectory
  ? (await getCollection('actionItem', ({ data }) => !data.draft)).sort(
      (a, b) => b.data.date.getTime() - a.data.date.getTime(),
    )
  : [];
const blogEntries = isBinaryDirectory
  ? (await getCollection('blog', ({ data }) => !data.draft)).sort(
      (a, b) => b.data.date.getTime() - a.data.date.getTime(),
    )
  : [];
const blogLanes = [
  { key: 'BUILD', name: 'Build', cadence: 'Monday · systems into reality' },
  { key: 'INVEST', name: 'Invest', cadence: 'Wednesday · signals into judgment' },
  { key: 'JOY', name: 'Joy', cadence: 'Friday · curiosity into meaning' },
] as const;
const diaryEntries = isMeaningDirectory
  ? (await getCollection('diary', ({ data }) => !data.draft)).sort(
      (a, b) => b.data.date.getTime() - a.data.date.getTime(),
    )
  : [];

const compactDate = (date: Date) => date.toISOString().slice(0, 10).replaceAll('-', '');
const displayDate = (date: Date) => date.toLocaleDateString('en-US', {
  timeZone: 'UTC', month: 'long', day: 'numeric', year: 'numeric',
});
const path = `/${entry.slug}/`;
const ouroborosSchemas = isOuroborosDirectory
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        '@id': 'https://iamrobin.ai/ouroboros/#archive',
        name: 'Ouroboros — Robin Xie',
        description: 'Robin Xie’s Daily Briefings, Daily Action Flows, and Daily Action Items.',
        url: 'https://iamrobin.ai/ouroboros/',
        inLanguage: 'en',
        author: { '@id': 'https://iamrobin.ai/#person' },
      },
      createPersonSchema(),
      createBreadcrumbSchema([
        { name: 'Home', path: '/' },
        { name: 'Ouroboros', path: '/ouroboros/' },
      ]),
    ]
  : undefined;
const binarySchemas = isBinaryDirectory
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        '@id': 'https://iamrobin.ai/binary/#blog',
        name: 'Binary · Blog — Robin Xie',
        description: 'Robin Xie’s Build, Invest, and Joy essays, published on a Monday, Wednesday, Friday rhythm.',
        url: 'https://iamrobin.ai/binary/',
        inLanguage: 'en',
        author: { '@id': 'https://iamrobin.ai/#person' },
      },
      createPersonSchema(),
      createBreadcrumbSchema([
        { name: 'Home', path: '/' },
        { name: 'Binary', path: '/binary/' },
      ]),
    ]
  : undefined;
const meaningSchemas = isMeaningDirectory
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        '@id': 'https://iamrobin.ai/meaning/#diary',
        name: 'Meaning · Diary — Robin Xie',
        description: 'Dated notes by Robin Xie, preserved in her original words.',
        url: 'https://iamrobin.ai/meaning/',
        inLanguage: 'und',
        author: { '@id': 'https://iamrobin.ai/#person' },
      },
      createPersonSchema(),
      createBreadcrumbSchema([
        { name: 'Home', path: '/' },
        { name: 'Meaning', path: '/meaning/' },
      ]),
    ]
  : undefined;
---

<BaseLayout
  title={`${entry.word} — I AM ROBIN`}
  description={isOuroborosDirectory
    ? 'Daily Briefings, Daily Action Flows, and Daily Action Items by Robin Xie.'
    : isBinaryDirectory
      ? 'Build, Invest, and Joy essays by Robin Xie.'
    : isMeaningDirectory
      ? 'Dated notes by Robin Xie, preserved in her original words.'
    : `${entry.word}: a living project directory inside the I AM ROBIN identity map.`}
  {path}
  noindex={!isOuroborosDirectory && !isBinaryDirectory && !isMeaningDirectory}
  schema={ouroborosSchemas ?? binarySchemas ?? meaningSchemas}
>
  <section class:list={['identity-directory', { 'identity-directory--library': isOuroborosDirectory || isBinaryDirectory || isMeaningDirectory }, 'shell']}>
    <a class="directory-back" href="/">← I AM ROBIN</a>
    <div class={`directory-letter directory-letter--${entry.tone}`} aria-hidden="true">{entry.letter}</div>
    <p class="eyebrow">{String(index + 1).padStart(2, '0')} / 08 · project directory</p>
    <h1>{entry.word}</h1>
    {
      isOuroborosDirectory ? (
        <section class="ouroboros-library" aria-label="Ouroboros publication archive">
          <details class="ouroboros-shelf" open>
            <summary>
              <span class="ouroboros-shelf__number">01</span>
              <span class="ouroboros-shelf__name">Daily Briefing</span>
              <em>Signals in motion.</em>
              <span class="ouroboros-shelf__toggle" aria-hidden="true">+</span>
            </summary>
            <nav class="ouroboros-shelf__list" aria-label="Daily Briefing archive">
              {briefings.map((briefing) => {
                const date = compactDate(briefing.data.date);
                return (
                  <a href={`/ouroboros/${date.slice(0, 6)}/${date}/`}>
                    <time datetime={briefing.data.date.toISOString().slice(0, 10)}>{displayDate(briefing.data.date)}</time>
                    <span aria-hidden="true">→</span>
                  </a>
                );
              })}
            </nav>
          </details>

          <details class="ouroboros-shelf" open>
            <summary>
              <span class="ouroboros-shelf__number">02</span>
              <span class="ouroboros-shelf__name">Daily Action Flow</span>
              <em>Signal into execution.</em>
              <span class="ouroboros-shelf__toggle" aria-hidden="true">+</span>
            </summary>
            <nav class="ouroboros-shelf__list" aria-label="Daily Action Flow archive">
              {actionFlows.map((flow) => {
                const date = flow.date.replaceAll('-', '');
                const action = actionItems.find((item) => compactDate(item.data.date) === date);
                return (
                  <div class="ouroboros-shelf__day">
                    <a href={`/ouroboros/${date.slice(0, 6)}/${date}/actions/`}>
                      <time datetime={flow.date}>{displayDate(new Date(`${flow.date}T12:00:00Z`))}</time>
                      <strong>{flow.signalCount} signals · Daily Action Flow</strong>
                      <span aria-hidden="true">→</span>
                    </a>
                    {action && (
                      <a class="ouroboros-shelf__deep" href={`/ouroboros/${date.slice(0, 6)}/${date}/action_item/`}>
                        <small>Signal 05 · canonical deep dive</small>
                        <strong>{action.data.title}</strong>
                        <span aria-hidden="true">→</span>
                      </a>
                    )}
                  </div>
                );
              })}
            </nav>
          </details>

        </section>
      ) : isBinaryDirectory ? (
        <section class="ouroboros-library binary-library" aria-label="Binary Blog archive">
          <header class="binary-library__heading">
            <span aria-hidden="true">M · W · F</span>
            <h2>Blog</h2>
            <em>Build · Invest · Joy</em>
          </header>
          <div class="binary-lanes">
            {blogLanes.map((lane, laneIndex) => {
              const articles = blogEntries.filter((article) => article.data.lane === lane.key);
              const present = articles.filter((article) => blogArchiveStatus(article.data.date) === 'PRESENT');
              const pipeline = articles.filter((article) => blogArchiveStatus(article.data.date) === 'PIPELINE');
              return (
                <section class="binary-lane" aria-labelledby={`binary-lane-${lane.key.toLowerCase()}`}>
                  <header class="binary-lane__heading">
                    <span>{String(laneIndex + 1).padStart(2, '0')}</span>
                    <h3 id={`binary-lane-${lane.key.toLowerCase()}`}>{lane.name}</h3>
                    <em>{lane.cadence}</em>
                  </header>
                  {present.length ? (
                    <nav class="ouroboros-shelf__list binary-present" aria-label={`${lane.name} present articles`}>
                      {present.map((article) => {
                        const date = compactDate(article.data.date);
                        return (
                          <a href={`/ouroboros/${date.slice(0, 6)}/${date}/blog/`}>
                            <time datetime={article.data.date.toISOString().slice(0, 10)}>{displayDate(article.data.date)}</time>
                            <strong>{blogTitle(article.data.date, 'en', article.data.title)}</strong>
                            <span aria-hidden="true">→</span>
                          </a>
                        );
                      })}
                    </nav>
                  ) : (
                    <p class="ouroboros-shelf__empty">The first present story has not arrived yet.</p>
                  )}
                  {pipeline.length > 0 && (
                    <details class="binary-pipeline">
                      <summary>
                        <span>Pipeline</span>
                        <small>{pipeline.length} future {pipeline.length === 1 ? 'article' : 'articles'}</small>
                        <span class="binary-pipeline__toggle" aria-hidden="true">+</span>
                      </summary>
                      <nav class="ouroboros-shelf__list" aria-label={`${lane.name} pipeline`}>
                        {pipeline.map((article) => {
                          const date = compactDate(article.data.date);
                          return (
                            <a href={`/ouroboros/${date.slice(0, 6)}/${date}/blog/`}>
                              <time datetime={article.data.date.toISOString().slice(0, 10)}>{displayDate(article.data.date)}</time>
                              <strong>{blogTitle(article.data.date, 'en', article.data.title)}</strong>
                              <span aria-hidden="true">→</span>
                            </a>
                          );
                        })}
                      </nav>
                    </details>
                  )}
                </section>
              );
            })}
          </div>
        </section>
      ) : isMeaningDirectory ? (
        <section class="diary-library" id="diary" aria-labelledby="diary-library-title">
          <div class="diary-library__heading">
            <span>01</span>
            <h2 id="diary-library-title">Diary</h2>
            <em>as it was written</em>
          </div>
          {diaryEntries.length ? (
            <nav aria-label="Diary archive">
              {diaryEntries.map((diary) => {
                const date = compactDate(diary.data.date);
                return (
                  <a href={`/meaning/diary/${date.slice(0, 6)}/${diary.id.split('/')[0]}/`}>
                    <time datetime={diary.data.date.toISOString().slice(0, 10)}>{displayDate(diary.data.date)}</time>
                    <strong>{diary.data.title}</strong>
                    <span aria-hidden="true">→</span>
                  </a>
                );
              })}
            </nav>
          ) : (
            <p class="diary-library__empty">A note will appear when it asks to be kept.</p>
          )}
        </section>
      ) : isPressDirectory ? (
        <section class="press-directory" aria-labelledby="press-directory-title">
          <h2 id="press-directory-title">Press</h2>
          <nav aria-label="Selected press">
            {pressLinks.map((item) => (
              <a href={item.href} rel="noreferrer" target="_blank">
                <small>{item.source}</small>
                <strong>{item.label}</strong>
                <span aria-hidden="true">↗</span>
              </a>
            ))}
          </nav>
        </section>
      ) : (
        <ul>
          {entry.projects.map((project) => <li><span></span>{project}</li>)}
          <li class="directory-future"><span></span>more, as it becomes</li>
        </ul>
      )
    }
    <nav class="directory-cycle" aria-label="Identity directories">
      <a href={`/${previous.slug}/`}>← {previous.word}</a>
      <a href={`/${next.slug}/`}>{next.word} →</a>
    </nav>
  </section>
</BaseLayout>
