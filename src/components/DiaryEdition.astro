---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import OuroborosPublication from './OuroborosPublication.astro';
import { createDiarySchemas } from '../lib/seo';
interface Props { entry: CollectionEntry<'diary'>; }
const { entry } = Astro.props;
const { Content } = await render(entry);
const publicationDate = entry.data.date.toISOString().slice(0, 10);
const displayDate = entry.data.date.toLocaleDateString('en-US', { timeZone: 'UTC', month: 'long', day: 'numeric', year: 'numeric' });
const path = new URL(entry.data.canonical).pathname;
const family = (await getCollection('diary', ({data}) => !data.draft)).filter((item) => item.data.sourceId === entry.data.sourceId);
const original = family.find((item) => item.data.inLanguage === entry.data.originalLanguage) ?? entry;
const names: Record<string,string> = { en: 'English', 'zh-Hans': '简体中文', 'zh-Hant': '繁體中文', ja: '日本語' };
const languages = family.map((item) => ({ hreflang: item.data.inLanguage, path: new URL(item.data.canonical).pathname, label: names[item.data.inLanguage] ?? item.data.inLanguage }));
const localized: Record<string,[string,string,string]> = {
  en: ['A conversation about cells, swarms, and learning to live without the ladder.', 'A diary conversation, with questions, metaphors and speculative ideas preserved as conversation—not medical advice.', 'Return to Diary →'],
  'zh-Hans': ['从细胞、智能体群聊到如何学会离开梯子。', '日记保留对话中的提问、比喻与思想实验，不作为医学建议。', '返回日记 →'],
  'zh-Hant': ['從細胞、智慧體群聊到如何學會離開梯子。', '日記保留對話中的提問、比喻與思想實驗，不作為醫學建議。', '返回日記 →'],
  ja: ['細胞、エージェントの群れ、そして梯子を離れて生きることをめぐる対話。', '問い、比喩、思考実験をそのまま残した日記です。医学的な助言ではありません。', '日記に戻る →'],
};
const words = entry.data.source === 'owner-document' ? localized[entry.data.inLanguage] : ['A moment, kept in its own words.', 'Original text preserved. No translation.', 'Return to Diary →'];
const labWords:Record<string,[string,string]>={en:['Try the four experiments →','From conversation to a playable Swarm Lab: change the rules, compare controls, inspect the results. Educational toy models—not biological experiments.'], 'zh-Hans':['亲手试试这四个实验 →','把这场聊天变成可以玩的 Swarm Lab：改变规则，对比结果，检查证据。这些是教学模型，不是生物实验。'], 'zh-Hant':['親手試試這四個實驗 →','把這場聊天變成可以玩的 Swarm Lab：改變規則，對比結果，檢查證據。這些是教學模型，不是生物實驗。'],ja:['四つの実験を試す →','この対話から生まれた Swarm Lab。ルールを変え、比較し、結果を確かめられます。生物実験ではなく、学習用の簡略化したモデルです。']};
const schemas = createDiarySchemas({title: entry.data.title, description: entry.data.excerpt, path, image: entry.data.ogImage,
  datePublished: publicationDate, dateModified: entry.data.updated.toISOString().slice(0,10), inLanguage: entry.data.inLanguage });
---
<OuroborosPublication kind="diary" title={entry.data.title} description={entry.data.excerpt} {path}
  image={entry.data.ogImage} imageAlt={entry.data.title} hero={entry.data.hero} heroAlt={entry.data.title}
  {publicationDate} {displayDate} schema={schemas} language={entry.data.inLanguage}
  alternates={[...languages,{hreflang:'x-default',path:new URL(original.data.canonical).pathname}]}
  languageLinks={languages.filter((item)=> item.hreflang!==entry.data.inLanguage)}
  crumbs={[{label:'Meaning',href:'/meaning/'},{label:'Diary'}]}
  intro={words[0]} footerText={words[1]} footerLink="/meaning/#diary" footerLinkLabel={words[2]}>
  <div class="diary-document"><Content /></div>
  {entry.data.sourceId==='2026-09-24-from-art-to-immortal-cells'&&<aside class="diary-lab"><a href="/intelligence/swarm-lab/">{labWords[entry.data.inLanguage][0]}</a><p>{labWords[entry.data.inLanguage][1]}</p></aside>}
</OuroborosPublication>
<style>
  .diary-lab{margin-top:3rem;padding:1.5rem;border-block:1px solid var(--line);background:rgba(98,127,107,.06)}.diary-lab p{font-size:.9rem;line-height:1.8;margin-bottom:0}
  .diary-document :global(p) { white-space: pre-wrap; }
  .diary-document :global(.diary-speaker) { margin-top: 3rem; margin-bottom: 1rem; }
  .diary-document :global(.diary-table) { overflow-x: auto; margin: 2rem 0; }
  .diary-document :global(table) { width: 100%; border-collapse: collapse; font-size: .9em; }
  .diary-document :global(th), .diary-document :global(td) { border: 1px solid var(--line); padding: .75rem; min-width: 9rem; vertical-align: top; }
  .diary-document :global(th) { text-align: left; background: rgba(180,145,93,.07); }
  .diary-document :global(td p) { margin: 0; }
</style>
