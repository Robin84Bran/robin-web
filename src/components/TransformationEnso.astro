<figure class="transformation-enso" data-enso-motion="paused" aria-label="Engineering → FinTech → Entrepreneurship → Transformation">
  <div class="enso-field">
    <svg class="enso-flow" viewBox="0 0 440 440" fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="enso-ink" x1="80" y1="80" x2="365" y2="365" gradientUnits="userSpaceOnUse">
          <stop stop-color="#b99163" stop-opacity=".65" />
          <stop offset=".45" stop-color="#786952" stop-opacity=".8" />
          <stop offset="1" stop-color="#d9a5a5" stop-opacity=".55" />
        </linearGradient>
      </defs>
      <g class="enso-current enso-current--ink" stroke="url(#enso-ink)" stroke-linecap="round">
        <path d="M 252 73 C 340 83 378 151 367 238 C 355 330 282 378 194 365 C 106 352 65 294 75 208 C 83 128 139 77 213 76" stroke-width="10" opacity=".62" />
        <path d="M 271 82 C 346 102 381 184 359 263 C 335 348 251 386 173 359 C 89 330 58 245 84 169 C 105 109 157 79 222 83" stroke-width="2" opacity=".5" />
        <path d="M 240 82 C 322 87 367 155 357 239 C 346 317 281 365 198 354 C 125 344 78 283 84 213 C 90 145 139 93 205 85" stroke-width="3" opacity=".3" />
      </g>
      <g class="enso-current enso-current--wash" stroke="#c89a86" stroke-linecap="round">
        <path d="M 102 304 C 72 267 64 203 93 151 C 126 91 187 68 257 87 C 328 106 368 165 353 238" stroke-width="1.5" opacity=".28" />
        <path d="M 349 277 C 316 346 237 374 166 345" stroke-width="5" opacity=".12" />
      </g>
    </svg>
    <ol class="enso-stages" aria-hidden="true">
      <li>Engineering <span>→</span></li>
      <li>FinTech <span>→</span></li>
      <li>Entrepreneurship <span>→</span></li>
      <li>Transformation <span>→</span></li>
    </ol>
  </div>
  <button class="enso-motion-toggle" type="button" aria-label="Pause ensō motion" hidden>Pause motion</button>
</figure>

<style>
  .transformation-enso { width: min(100%, 29rem); margin: 0 auto; }
  .enso-field { position: relative; aspect-ratio: 1; }
  .enso-flow { display: block; width: 100%; height: 100%; overflow: visible; }
  .enso-current { transform-origin: 220px 220px; animation: enso-flow 54s linear infinite; animation-play-state: paused; }
  .enso-current--wash { animation-name: enso-return; animation-duration: 39s; }
  [data-enso-motion="running"] .enso-current { animation-play-state: running; }
  .enso-stages { position: absolute; inset: 0; margin: 0; padding: 0; list-style: none; }
  .enso-stages li { position: absolute; padding: .35rem .3rem; color: var(--ink); background: var(--paper, #f6f2eb); font-family: var(--serif); font-size: clamp(.85rem, 1.3vw, 1rem); white-space: nowrap; }
  .enso-stages span { color: var(--gold-dark); margin-left: .2rem; font-family: var(--sans); font-size: .7em; }
  .enso-stages li:nth-child(1) { top: 6%; left: 50%; transform: translateX(-50%); }
  .enso-stages li:nth-child(2) { top: 48%; right: 0; }
  .enso-stages li:nth-child(3) { bottom: 5%; left: 50%; transform: translateX(-50%); }
  .enso-stages li:nth-child(4) { top: 48%; left: 0; }
  .enso-motion-toggle { display: block; margin: .7rem auto 0; padding: .55rem .8rem; color: var(--muted); background: transparent; border: 0; font: inherit; font-size: .65rem; letter-spacing: .06em; cursor: pointer; text-underline-offset: .3em; }
  .enso-motion-toggle[hidden] { display: none; }
  .enso-motion-toggle:hover { text-decoration: underline; }
  .enso-motion-toggle:focus-visible { outline: 1px solid var(--gold-dark); outline-offset: 3px; }
  @keyframes enso-flow { to { transform: rotate(360deg); } }
  @keyframes enso-return { to { transform: rotate(-360deg); } }
  @media (prefers-reduced-motion: reduce) { .enso-current { animation: none; } }
</style>

<script>
  const figure = document.querySelector<HTMLElement>('.transformation-enso');
  const button = figure?.querySelector<HTMLButtonElement>('.enso-motion-toggle');
  if (figure && button) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let pausedByUser = false;
    let visible = false;
    const update = () => {
      const running = !reducedMotion.matches && !pausedByUser && visible && !document.hidden;
      figure.dataset.ensoMotion = running ? 'running' : 'paused';
      button.hidden = reducedMotion.matches;
      button.textContent = pausedByUser ? 'Play motion' : 'Pause motion';
      button.setAttribute('aria-label', pausedByUser ? 'Play ensō motion' : 'Pause ensō motion');
    };
    button.addEventListener('click', () => { pausedByUser = !pausedByUser; update(); });
    reducedMotion.addEventListener('change', update);
    document.addEventListener('visibilitychange', update);
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; update(); }).observe(figure);
    update();
  }
</script>
