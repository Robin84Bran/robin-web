---
import { socialLinks } from '../data/site';
const corePage = ['/about/', '/identity/'].includes(Astro.url.pathname);
---

<footer class="site-footer">
  <div class="footer-inner">
    <p><span aria-hidden="true">○</span> Hong Kong · Earth · ∞</p>
    <p class="footer-mantra">{corePage ? 'I AM ROBIN.' : 'I seek. I become. I AM.'}</p>
    <nav class="footer-social" aria-label="Robin elsewhere">
      <a href={socialLinks.github} rel="noreferrer" target="_blank">GitHub ↗</a>
      <a href={socialLinks.linkedin} rel="noreferrer" target="_blank">LinkedIn ↗</a>
    </nav>
  </div>
</footer>
