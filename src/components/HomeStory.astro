---
import BaseLayout from '../layouts/BaseLayout.astro';
import IdentityGarden from '../components/IdentityGarden.astro';
import IdentityBridge from '../components/IdentityBridge.astro';
import { identityHomeAlternates, identityProfiles } from '../data/identity';
import { createIdentityPageSchemas, createHomeSchemas } from '../lib/seo';

import { homepageCopy, homeHans, homeHant, type HomeLocale } from '../data/homeChinese';
interface Props { locale?: HomeLocale }
const { locale = 'en' } = Astro.props;
const identity = identityProfiles[locale];
const { t, a } = homepageCopy(locale);
---

<BaseLayout
  title={identity.title}
  description={identity.description}
  path={identity.homePath}
  language={locale}
  alternates={identityHomeAlternates}
  schema={locale === 'en' ? createHomeSchemas() : createIdentityPageSchemas(locale, identity.homePath, identity.title, identity.description)}
>
  <section class="zen-home shell" aria-labelledby="zen-home-title">
    <header class="zen-name">
      <p class="eyebrow" {...a("roles", "ENTREPRENEUR · INVESTOR · ENGINEER")}>{t("roles", "ENTREPRENEUR · INVESTOR · ENGINEER")}</p>
      <h1 id="zen-home-title" data-home-html {...a('title','<span>Ms.</span> Robin Xie<small>谢玢 · 謝玢</small>')} set:html={t('title','<span>Ms.</span> Robin Xie<small>谢玢 · 謝玢</small>')} />
    </header>

    <figure class="time-portrait">
      <img src="/photos/hero-watch.jpg" alt="Robin pictured inside a watch face" width="829" height="1122" />
      <span class="time-portrait__orbit time-portrait__orbit--one" aria-hidden="true"></span>
      <span class="time-portrait__orbit time-portrait__orbit--two" aria-hidden="true"></span>
      <figcaption><span>Time is a loop.</span><small>HK ↔ US</small></figcaption>
    </figure>

    <span class="zen-axis" aria-hidden="true"></span>
    <div class="zen-garden"><IdentityGarden locale={locale} /></div>

    <p class="zen-mantra">I seek. <span>I become.</span> I AM.</p>
    <nav class="zen-portals" aria-label="Continue exploring">
      <a href="/about/">About</a>
      <span aria-hidden="true">·</span>
      <a href="/portfolio/">Portfolio</a>
      <span aria-hidden="true">·</span>
      <a href="/books/">Books</a>
    </nav>
    <p class="zen-side-note" aria-hidden="true">AMERICAN FRONTIER MIND · JAPANESE ZEN SURFACE</p>
  </section>
  <IdentityBridge locale={locale} />
  <script is:inline type="application/json" id="home-owner-copy" set:html={JSON.stringify({'zh-CN':homeHans,'zh-TW':homeHant}).replaceAll('<','\\u003c')} />
</BaseLayout>
