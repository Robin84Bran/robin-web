---
import TransformationEnso from './TransformationEnso.astro';
import { homepageCopy, type HomeLocale } from '../data/homeChinese';
import { homeNowEnglish } from '../data/homeNow';
interface Props { locale?: HomeLocale }
const { locale = 'en' } = Astro.props;
const { t, a } = homepageCopy(locale);
---

<section class="identity-bridge identity-bridge--transformation shell" aria-labelledby="robin-introduction">
  <div class="identity-bridge__copy">
    <p class="eyebrow" {...a('signature','Robin Xie · 谢玢 · 謝玢')}>{t('signature','Robin Xie · 谢玢 · 謝玢')}</p>
    <h2 id="robin-introduction" data-home-html {...a('roles','Entrepreneur and investor<br /><span>with an engineering background.</span>')} set:html={t('roles','Entrepreneur and investor<br /><span>with an engineering background.</span>')} />
    <p {...a('intro',"I began in subsea engineering, moved into FinTech and entrepreneurship, and now build AI-native businesses and systems while allocating attention and capital.")} set:html={t('intro',"I began in subsea engineering, moved into FinTech and entrepreneurship, and now build AI-native businesses and systems while allocating attention and capital.")} />
  </div>
  <TransformationEnso locale={locale} />
  <section class="identity-now" aria-labelledby="robin-now">
    <h3 id="robin-now" class="eyebrow" {...a('now','Now')}>{t('now','Now')}</h3>
    {Object.entries(homeNowEnglish).map(([key, fallback]) => (
      <p class:list={{ 'identity-now__title': key === 'nowTitle' }} data-home-html {...a(key, fallback)} set:html={t(key, fallback)} />
    ))}
  </section>
  <section class="identity-past" aria-labelledby="robin-past">
    <h3 id="robin-past" class="eyebrow" {...a('past','Past')}>{t('past','Past')}</h3>
    <div class="identity-past__story">
      <p {...a('past0',"My career began in subsea engineering, working with complex offshore systems and autonomous machines. It taught me to bring ideas into contact with the physical world, where reliability matters and assumptions have consequences.")} set:html={t('past0',"My career began in subsea engineering, working with complex offshore systems and autonomous machines. It taught me to bring ideas into contact with the physical world, where reliability matters and assumptions have consequences.")} />
      <p {...a('past1',"From there, I moved into entrepreneurship and FinTech, working across payments, digital assets, and financial infrastructure. My attention expanded from how a system works to what a business could make possible.")} set:html={t('past1',"From there, I moved into entrepreneurship and FinTech, working across payments, digital assets, and financial infrastructure. My attention expanded from how a system works to what a business could make possible.")} />
      <p {...a('past2',"Building businesses led me toward capital allocation. I began asking where technology, capital, and human attention could create lasting value over decades, a question that continues to guide my investing across public and private markets.")} set:html={t('past2',"Building businesses led me toward capital allocation. I began asking where technology, capital, and human attention could create lasting value over decades, a question that continues to guide my investing across public and private markets.")} />
      <p {...a('past3',"That path brought me to AI infrastructure, energy, robotics, and programmable finance. Through RobinOS, quantitative research labs, and AI-assisted workflows, I have explored how ideas become working systems, with human judgment and responsibility at their center.")} set:html={t('past3',"That path brought me to AI infrastructure, energy, robotics, and programmable finance. Through RobinOS, quantitative research labs, and AI-assisted workflows, I have explored how ideas become working systems, with human judgment and responsibility at their center.")} />
      <p {...a('past4',"Along the way, I kept writing, experimenting, and following connections between fields. Some ideas became investments; others became things I built. Those experiences brought me here, still curious about what might become possible next.")} set:html={t('past4',"Along the way, I kept writing, experimenting, and following connections between fields. Some ideas became investments; others became things I built. Those experiences brought me here, still curious about what might become possible next.")} />
    </div>
  </section>
</section>

<style>
  .identity-bridge--transformation { gap: 2.5rem 3rem; }
  .identity-bridge__copy h2 { margin: 1.2rem 0 1.5rem; font-size: clamp(2rem, 3.8vw, 3.15rem); line-height: 1.14; letter-spacing: -.035em; }
  .identity-bridge__copy h2 :global(span) { color: var(--muted); font-size: .76em; }
  .identity-bridge__copy > p:not(.eyebrow) { font-size: clamp(1.1rem, 1.6vw, 1.25rem); line-height: 1.75; margin-bottom: 0; }
  .identity-now { max-width: 43rem; border-top: 1px solid var(--line); padding-top: 1.5rem; }
  .identity-now h3 { margin: 0 0 1rem; color: var(--gold-dark); }
  .identity-now p { color: var(--muted); font-size: .96rem; line-height: 1.85; }
  .identity-now .identity-now__title { color: var(--ink); font-size: 1.12rem; }
  .identity-now .identity-now__title:empty { display: none; }
  .identity-now p:last-child { margin-bottom: 0; }
  .identity-now :global(a) { color: var(--ink); text-decoration-color: var(--gold); text-underline-offset: .22em; }
  .identity-past { grid-column: 1 / -1; display: grid; gap: 1rem 3rem; border-top: 1px solid var(--line); padding-top: 2rem; }
  .identity-past h3 { margin: 0; color: var(--gold-dark); }
  .identity-past__story { max-width: 43rem; }
  .identity-past__story p { margin: 0 0 1.25rem; color: var(--muted); font-size: 1rem; line-height: 1.85; }
  .identity-past__story p:last-child { margin-bottom: 0; }
  @media (min-width: 60rem) {
    .identity-bridge--transformation { grid-template-columns: minmax(0, 1.3fr) minmax(22rem, 1fr); align-items: start; }
    .identity-bridge__copy { grid-column: 1; grid-row: 1; }
    .identity-bridge--transformation :global(.transformation-enso) { grid-column: 2; grid-row: 1; align-self: center; }
    .identity-now { grid-column: 1 / -1; grid-row: 2; }
    .identity-past { grid-template-columns: minmax(8rem, .45fr) minmax(0, 1.85fr); }
  }
  @media (max-width: 59.99rem) {
    .identity-bridge--transformation { grid-template-columns: minmax(0, 1fr); }
  }
</style>
