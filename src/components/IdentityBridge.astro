---
import IdentityLanguageNav from './IdentityLanguageNav.astro';
import IdentityOrbit from './IdentityOrbit.astro';
import SakuraDrift from './SakuraDrift.astro';
import { identityProfiles } from '../data/identity';

const profile = identityProfiles.en;
---

<section class="identity-bridge shell" aria-label="Robin Xie identity journey">
  <SakuraDrift variant="banner" />
  <div class="identity-bridge__copy">
    <p class="eyebrow">Engineering → FinTech → Capital → AI Systems</p>
    <p>{profile.description}</p>
    <blockquote>{profile.spine}</blockquote>
    <a class="quiet-link" href={profile.aboutPath}>{profile.aboutLinkLabel}<span aria-hidden="true">↗</span></a>
  </div>
  <IdentityOrbit items={profile.axis} label={profile.spine} centerLabel={profile.orbitLabel} />
  <IdentityLanguageNav currentLocale="en" page="home" />
</section>
