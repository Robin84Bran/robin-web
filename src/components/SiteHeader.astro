---
import { navItems, socialLinks } from '../data/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href="/" aria-label="Robin Xie home">
      <span class="wordmark-mark">R</span>
      <span>ROBIN XIE</span>
    </a>
    <nav aria-label="Primary">
      <ul class="nav-list">
        {
          navItems.map((item) => (
            <li>
              <a aria-current={currentPath === item.href ? 'page' : undefined} href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="github-link" href={socialLinks.official} rel="noreferrer" target="_blank">
      Official <span aria-hidden="true">↗</span>
    </a>
  </div>
</header>
