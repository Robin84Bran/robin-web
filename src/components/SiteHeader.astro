---
import { identityWords, navItems, socialLinks } from '../data/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href="/" aria-label="Robin Xie home">
      <span class="wordmark-mark">R</span>
      <span>ROBIN XIE</span>
    </a>
    <nav aria-label="Primary">
      <ul class="nav-list">
        {
          navItems.map((item) => (
            <li>
              <a aria-current={currentPath === item.href ? 'page' : undefined} href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="doors-nav">
          <details>
            <summary aria-label="Open the eight identity doors">Doors</summary>
            <div class="doors-menu" role="group" aria-label="Identity doors">
              {identityWords.map((entry) => (
                <a aria-current={currentPath === `/${entry.slug}/` ? 'page' : undefined} href={`/${entry.slug}/`}>
                  <span aria-hidden="true">{entry.letter}</span>
                  <strong>{entry.word}</strong>
                </a>
              ))}
            </div>
          </details>
        </li>
      </ul>
    </nav>
    <a class="github-link" href={socialLinks.official} rel="noreferrer" target="_blank">
      Official <span aria-hidden="true">↗</span>
    </a>
  </div>
</header>
