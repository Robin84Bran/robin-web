<figure class="cheeky-box" data-cheeky-box>
  <svg viewBox="0 0 440 440" role="img" aria-labelledby="cheeky-title cheeky-desc">
    <title id="cheeky-title">The IPO box has a little devil inside.</title>
    <desc id="cheeky-desc">A pink troublemaker pops out, winks and sticks out its tongue. Its joke receipt says zero shares. This illustration is not an allocation result.</desc>
    <defs>
      <radialGradient id="box-halo"><stop stop-color="#f3dce3" stop-opacity=".7"/><stop offset="1" stop-color="#f3dce3" stop-opacity="0"/></radialGradient>
      <clipPath id="imp-window"><path d="M50 20H400V238L223 322 60 239Z"/></clipPath>
    </defs>
    <circle cx="225" cy="212" r="195" fill="url(#box-halo)"/>
    <text x="220" y="32" text-anchor="middle" class="micro">HANDLE WITH DESIRE.</text>
    <ellipse cx="222" cy="374" rx="139" ry="17" fill="#9a737e" opacity=".1"/>
    <g class="mischief">
      <g class="confetti" fill="none" stroke-width="3" stroke-linecap="round">
        <path d="m81 132 9-11m-33 72 12 3m282-67 10 10m-21 65 14-4" stroke="#b17a91"/>
        <path d="m104 79 5 10m221-25-3 14m-29 20 6-6" stroke="#b4915d"/>
        <path d="M63 103c-12-13-19 2 0 14 19-12 12-27 0-14ZM364 164c-12-13-19 2 0 14 19-12 12-27 0-14Z" fill="#dfb7c4" stroke="none"/>
      </g>
      <path d="M85 243 215 182 352 247 223 314Z" fill="#57414e" stroke="#8b6b47" stroke-width="1.5"/>
      <g clip-path="url(#imp-window)">
        <g class="imp">
          <path d="M265 221q85 19 50-45" fill="none" stroke="#ad5875" stroke-width="7" stroke-linecap="round"/>
          <path d="m299 181 12-25 21 22Z" fill="#ad5875"/>
          <path d="M143 142q-20-22-7-52 26 11 35 35M251 122q16-30 44-35 4 34-23 54" fill="#ad5875" stroke="#803f5a" stroke-width="2"/>
          <path d="M133 185q-3-72 76-76 78-3 82 70l-1 92-150 4Z" fill="#df99b2" stroke="#803f5a" stroke-width="2"/>
          <path d="M144 179q7-56 61-57" fill="none" stroke="#f6c9d9" stroke-width="5" stroke-linecap="round"/>
          <ellipse cx="170" cy="197" rx="17" ry="8" fill="#cb688d" opacity=".5"/>
          <ellipse cx="260" cy="192" rx="17" ry="8" fill="#cb688d" opacity=".5"/>
          <path d="m166 159 23 3m45-9 22-6" fill="none" stroke="#673b4e" stroke-width="4" stroke-linecap="round"/>
          <ellipse cx="180" cy="178" rx="6" ry="10" fill="#493b40"/>
          <g class="wink"><path d="m236 180 14-7-3 11" fill="none" stroke="#493b40" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></g>
          <path d="M190 206q24 28 49-6-5 41-34 32Z" fill="#66354c"/>
          <path d="m193 209 8 2-3 9Z" fill="#fff7ec"/>
          <path class="tongue" d="M213 218q20-11 20 4c-1 28-27 29-27 11 0-8 3-11 7-15Z" fill="#ea657e" stroke="#af4966" stroke-width="1.5"/>
          <path d="m223 222-4 10" stroke="#af4966" stroke-width="1.5"/>
        </g>
      </g>
      <path d="M85 243 223 314V381L85 307Z" fill="#e4d9c9" stroke="#a38e70" stroke-width="1.5"/>
      <path d="M223 314 352 247V315L223 381Z" fill="#f1e8db" stroke="#a38e70" stroke-width="1.5"/>
      <path d="m130 267 24 13v64l-24-13Z" fill="#d5a6b5"/>
      <text x="271" y="340" fill="#8b6b47" font-family="Georgia,serif" font-size="48" transform="rotate(-27 271 340)">?</text>
      <g class="paws" fill="#df99b2" stroke="#803f5a" stroke-width="2">
        <path d="M145 268c-8-26 5-37 14-27 8-12 20 3 15 27-6 11-23 10-29 0Z"/>
        <path d="M283 271c-6-25 7-37 15-25 10-9 19 9 12 29-8 10-22 6-27-4Z"/>
      </g>
      <g class="receipt" transform="rotate(12 331 306)">
        <path d="M292 271h78v97l-8-5-8 5-8-5-8 5-8-5-8 5-8-5-8 5-14-6Z" fill="#fffaf2" stroke="#a38e70"/>
        <text x="331" y="289" text-anchor="middle" class="receipt-label">ALLOTMENT</text>
        <text x="331" y="324" text-anchor="middle" class="receipt-zero">0</text>
        <text x="331" y="343" text-anchor="middle" class="receipt-label">TEASE ONLY</text>
      </g>
      <g class="lid">
        <path d="M76 228 213 164 359 231 223 301Z" fill="#f7eee3" stroke="#a38e70" stroke-width="1.5"/>
        <path d="M76 228v18l147 74v-19Z" fill="#d5c8b8" stroke="#a38e70" stroke-width="1.5"/>
        <path d="M223 301v19l136-69v-20Z" fill="#eadfce" stroke="#a38e70" stroke-width="1.5"/>
        <path d="m132 202 144 71 25-12-145-70Z" fill="#dfb7c4"/>
        <path d="m276 273 25-12v19l-25 12Z" fill="#c88ea3"/>
        <path d="M211 220c-38-47-57-5-3 8 51-2 54-50 10-12" fill="none" stroke="#ae6c87" stroke-width="5" stroke-linecap="round"/>
      </g>
    </g>
    <text x="220" y="417" text-anchor="middle" class="micro">ZERO SHARES. FULL ATTITUDE.</text>
  </svg>
  <figcaption>All tease. No allocation guarantee.</figcaption>
  <button type="button" class="tease-button" hidden>Tease me again ↗</button>
</figure>

<script>
  const box = document.querySelector<HTMLElement>('[data-cheeky-box]');
  const button = box?.querySelector<HTMLButtonElement>('button');
  if (box && button) {
    button.hidden = false;
    button.addEventListener('click', () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      box.getAnimations({ subtree: true }).forEach((animation) => {
        animation.currentTime = 0;
        animation.play();
      });
    });
  }
</script>

<style>
  .cheeky-box{margin:0;text-align:center;min-width:0}
  svg{display:block;width:100%;height:auto;overflow:visible}
  .micro{font:10px var(--mono);letter-spacing:2px;fill:#8c586a}
  .receipt-label{font:8px var(--mono);fill:#765565;letter-spacing:.6px}
  .receipt-zero{font:34px var(--serif);fill:#ac496f}
  figcaption{font:italic 15px var(--serif);color:var(--muted);margin:8px 0 14px}
  .tease-button{font:10px var(--mono);letter-spacing:.06em;color:#803f5a;background:#f8eaf0;border:1px solid #d5a6b5;border-radius:30px;padding:12px 19px;cursor:pointer;min-height:44px}
  .tease-button[hidden]{display:none}.tease-button:hover{background:#f0d5e0}.tease-button:focus-visible{outline:2px solid #803f5a;outline-offset:4px}
  .mischief{transform-origin:220px 372px;animation:shimmy 4.8s ease-in-out both}
  .lid{transform-origin:220px 245px;transform:translate(-22px,-174px) rotate(-17deg);animation:undress 4.8s cubic-bezier(.2,.7,.2,1) both}
  .imp{transform-origin:215px 267px;animation:peek 4.8s ease-in-out both}
  .paws{animation:paws 4.8s ease-in-out both}
  .receipt{animation:receipt 4.8s ease-in-out both;transform-box:fill-box;transform-origin:center}
  .confetti{animation:confetti 4.8s ease-out both;transform-origin:220px 220px}
  .wink{transform-box:fill-box;transform-origin:center;animation:wink 4.8s ease-in-out both}
  .tongue{transform-box:fill-box;transform-origin:top;animation:tongue 4.8s ease-in-out both}
  @keyframes shimmy{0%,10%,26%,100%{transform:rotate(0)}13%,20%{transform:rotate(-4deg)}16%,23%{transform:rotate(4deg)}40%{transform:rotate(-2deg)}50%{transform:rotate(1deg)}}
  @keyframes undress{0%,24%{transform:translate(0,0) rotate(0)}38%{transform:translate(-34px,-195px) rotate(-23deg)}52%,100%{transform:translate(-22px,-174px) rotate(-17deg)}}
  @keyframes peek{0%,26%{transform:translateY(152px) scale(.8)}43%{transform:translateY(-10px) scale(1.05)}55%,100%{transform:translateY(0) scale(1)}}
  @keyframes paws{0%,32%{opacity:0}45%,100%{opacity:1}}
  @keyframes receipt{0%,54%{opacity:0;transform:translateY(-36px) rotate(-8deg)}70%{opacity:1;transform:translateY(5px) rotate(17deg)}85%,100%{opacity:1;transform:translateY(0) rotate(12deg)}}
  @keyframes confetti{0%,30%{opacity:0;transform:scale(.6)}45%{opacity:1;transform:scale(1.07)}100%{opacity:.75;transform:scale(1)}}
  @keyframes wink{0%,52%,72%,100%{transform:scaleY(1)}59%,64%{transform:scaleY(.15)}}
  @keyframes tongue{0%,47%{transform:scaleY(.1)}60%{transform:scaleY(1.2) rotate(-9deg)}78%,100%{transform:scaleY(1)}}
  @media(prefers-reduced-motion:reduce){.mischief,.lid,.imp,.paws,.receipt,.confetti,.wink,.tongue{animation:none}.tease-button{display:none}}
  @media(max-width:700px){.cheeky-box{width:min(100%,360px);margin:0 auto}}
</style>
