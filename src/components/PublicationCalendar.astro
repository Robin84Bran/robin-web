---
export interface CalendarEntry { date: string; title: string; href: string; lane: string; }
interface Props { entries: CalendarEntry[]; lanes: {key:string; name:string; line:string; id:string}[]; name:string; }
const { entries, lanes, name } = Astro.props;
const sorted = [...entries].sort((a,b)=>b.date.localeCompare(a.date)||a.lane.localeCompare(b.lane));
const months = [...new Set(sorted.map(e=>e.date.slice(0,7)))];
const monthLabel = (m:string)=>new Date(m+'-15T12:00:00Z').toLocaleDateString('en-US',{month:'long',year:'numeric',timeZone:'UTC'});
---
<section class="publication-calendar" data-publication-calendar aria-label={`${name} calendar`}>
  <header class="calendar-intro"><p class="eyebrow">An archive, at a glance</p><h2>{name === 'Binary' ? 'A thought for every season.' : 'Follow the signal.'}</h2><p>Choose a day. Follow a thread. Leave room for the unexpected.</p></header>
  <div class="calendar-lanes">{lanes.map((lane,i)=><div id={lane.id}><span>0{i+1}</span><h3>{lane.name}</h3><p>{lane.line}</p></div>)}</div>
  <div class="calendar-interactive" hidden>
    <div class="calendar-toolbar"><button type="button" data-month-prev aria-label="Previous month">←</button><label><span class="sr-only">Archive month</span><select data-month>{months.map(m=><option value={m}>{monthLabel(m)}</option>)}</select></label><button type="button" data-month-next aria-label="Next month">→</button></div>
    <div class="calendar-filters" role="group" aria-label="Filter publications"><button type="button" data-lane="all" aria-pressed="true">All</button>{lanes.map(l=><button type="button" data-lane={l.key} aria-pressed="false">{l.name}</button>)}</div>
    <div class="calendar-spread"><div><div class="calendar-week" aria-hidden="true">{['M','T','W','T','F','S','S'].map(d=><span>{d}</span>)}</div><div class="calendar-grid" role="group" aria-label="Publication days"></div><p class="calendar-key">A mark means something was published.</p></div><section class="calendar-agenda" aria-live="polite" aria-atomic="true"><p class="eyebrow" data-selected-date></p><div data-agenda></div></section></div>
  </div>
  <details class="calendar-archive"><summary>Browse the complete archive <span>{sorted.length} publications ↗</span></summary>{months.map(m=><details class="calendar-archive-month"><summary>{monthLabel(m)}<span>{sorted.filter(e=>e.date.startsWith(m)).length}</span></summary><nav aria-label={`${monthLabel(m)} publications`}>{sorted.filter(e=>e.date.startsWith(m)).map(e=><a href={e.href}><time datetime={e.date}>{new Date(e.date+'T12:00:00Z').toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})}</time><span>{e.title}</span><small>{lanes.find(l=>l.key===e.lane)?.name}</small></a>)}</nav></details>)}</details>
  <script type="application/json" data-calendar-entries is:inline set:html={JSON.stringify(sorted).replaceAll('<','\\u003c')} />
  <script type="application/json" data-calendar-lanes is:inline set:html={JSON.stringify(lanes).replaceAll('<','\\u003c')} />
</section>
<script>
  import { initPublicationCalendars } from '../lib/publicationCalendar';
  initPublicationCalendars();
</script>
<style is:global>
.identity-directory:has(.publication-calendar) h1 { margin-bottom: .5rem; }
.publication-calendar { margin-top: 1.3rem; }
.calendar-intro > .eyebrow { display:none; }
.calendar-intro h2 { font: clamp(1.4rem,3vw,2rem) var(--serif); margin: .6rem 0; font-weight:400; }
.calendar-intro > p:last-child { color:var(--muted); font-size:.9rem; }
.calendar-lanes { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; border-block:1px solid var(--line); margin:2rem 0 1rem; padding:1rem 0; }
.calendar-lanes > div { scroll-margin-top:8rem; } .calendar-lanes span { color:var(--muted); font-size:.65rem; letter-spacing:.15em; } .calendar-lanes h3 { font:1.2rem var(--serif); margin:.5rem 0; } .calendar-lanes p { color:var(--muted); font-size:.72rem; margin:0; line-height:1.5; }
.calendar-toolbar { display:flex; align-items:center; justify-content:space-between; margin:1.6rem 0 1rem; }
.calendar-toolbar select { font:1.4rem var(--serif); color:var(--ink); background:transparent; border:0; max-width:100%; padding:.4rem; }
.calendar-toolbar button,.calendar-filters button { background:transparent; color:var(--muted); border:0; font:inherit; cursor:pointer; min-height:44px; padding:.5rem .9rem; }
.calendar-filters { display:flex; flex-wrap:wrap; gap:.25rem; margin-bottom:1.4rem; font-size:.75rem; }
.calendar-filters button { border-bottom:1px solid transparent; } .calendar-filters button[aria-pressed=true] { color:var(--ink); border-color:var(--ink); }
.calendar-spread { display:grid; grid-template-columns:minmax(0,1.3fr) minmax(0,1fr); gap:3rem; }
.calendar-week,.calendar-grid { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); }
.calendar-week { color:var(--muted); text-align:center; font-size:.65rem; padding-bottom:.7rem; }
.calendar-grid button { width:100%; min-width:0; aspect-ratio:1.65; border:0; border-top:1px solid var(--line); border-radius:0; color:var(--muted); background:transparent; font: .85rem var(--sans); display:flex; align-items:center; justify-content:center; flex-direction:column; gap:.4rem; cursor:pointer; position:relative; }
.calendar-grid button[data-has-entry=true] {color:var(--ink)} .calendar-grid button[aria-pressed=true] { background:var(--ink); color:var(--moon-bright); }
.calendar-grid button:disabled { cursor:default; opacity:.45; } .calendar-grid button:focus-visible { outline:2px solid var(--ink); outline-offset:-3px; }
.calendar-grid i { width:3px; height:3px; border-radius:50%; background:currentColor; } .calendar-grid button span { display:flex; gap:3px; height:3px; }
.calendar-key { font-size:.65rem; color:var(--muted); margin:1rem 0; }
.calendar-agenda { border-left:1px solid var(--line); padding-left:2rem; min-height:16rem; } .calendar-agenda a {display:block; text-decoration:none; padding:1rem 0; border-bottom:1px solid var(--line); } .calendar-agenda small {display:block;color:var(--muted);font-size:.65rem;margin-bottom:.5rem;letter-spacing:.06em} .calendar-agenda h3 {font:1.25rem/1.4 var(--serif);margin:0;font-weight:400;} .calendar-agenda a:hover h3 {text-decoration:underline;text-underline-offset:4px;}
.calendar-archive { border-top:1px solid var(--line); margin-top:2rem; padding-top:1rem; } .calendar-archive summary { display:flex; justify-content:space-between; gap:1rem; cursor:pointer; font-size:.8rem; padding:.7rem 0; } .calendar-archive summary span {color:var(--muted);font-size:.7rem} .calendar-archive-month { border-bottom:1px solid var(--line); } .identity-directory .calendar-archive nav {display:block;letter-spacing:normal;text-transform:none;color:inherit;} .calendar-archive nav a {display:grid;grid-template-columns:6rem 1fr auto;gap:1rem;padding:.75rem 0;text-decoration:none;font-size:.8rem;border-top:1px solid var(--line)} .calendar-archive time,.calendar-archive small {color:var(--muted);font-size:.7rem}
.meaning-collection { margin-top:4rem; border-top:1px solid var(--line); padding-top:1.2rem; } .meaning-collection > header {display:flex;gap:1rem;align-items:baseline;} .meaning-collection > header span {font-size:.75rem;color:var(--muted)} .meaning-collection h2 {font:2rem var(--serif);font-weight:400;} .meaning-collection .collection-title {font:clamp(1.7rem,4vw,3rem) var(--serif);margin-bottom:.6rem;} .meaning-collection > p {color:var(--muted);line-height:1.6;} .meaning-collection .books-canvas,.meaning-collection .portfolio-canvas {width:100%;}
.binary-play {border-block:1px solid var(--line);padding:1.6rem 0;margin-top:3rem;} .binary-play > a {display:flex;gap:1.5rem;text-decoration:none;align-items:baseline;} .binary-play h2 {font:2rem var(--serif);margin:0;font-weight:400;} .binary-play p {color:var(--muted);font-size:.9rem;line-height:1.6;} .binary-play small {font-size:.7rem;color:var(--muted);}
@media(max-width:640px) { .calendar-spread {grid-template-columns:1fr;gap:1.5rem;} .calendar-agenda {border-left:0;padding-left:0;border-top:1px solid var(--line);padding-top:1rem;min-height:0;} .calendar-grid button {min-height:44px;height:44px;aspect-ratio:auto;} .calendar-lanes {gap:.7rem;} .calendar-lanes h3 {font-size:1rem;} .calendar-lanes p {font-size:.65rem;} .calendar-archive nav a {grid-template-columns:1fr;gap:.3rem;} .calendar-archive > summary {align-items:baseline;} .calendar-archive summary span {max-width:7rem;text-align:right;} }
</style>
