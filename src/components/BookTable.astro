---
import { books } from '../data/site';
---

<section class="book-table" aria-labelledby="book-table-title">
  <h2 class="sr-only" id="book-table-title">Four living books</h2>
  <span class="table-light" aria-hidden="true"></span>
  <div class="book-objects">
    {
      books.map((book, index) => (
        <article class={`book-object book-object--${index + 1}`}>
          <a href={`#${book.slug}`} id={book.slug} aria-label={`${book.title}: ${book.question}`}>
            <img src={book.cover} alt={`Cover of ${book.title}`} width="760" height="1140" loading={index < 2 ? 'eager' : 'lazy'} />
          </a>
          <div class="book-note">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{book.title}</h3>
            <p>{book.question}</p>
          </div>
        </article>
      ))
    }
  </div>
  <p class="table-signature">Living manuscripts · Robin Xie</p>
</section>
