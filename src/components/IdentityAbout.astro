---
import BaseLayout from '../layouts/BaseLayout.astro';
import IdentityLanguageNav from './IdentityLanguageNav.astro';
import SakuraDrift from './SakuraDrift.astro';
import { identityAboutAlternates, identityProfiles, type IdentityLocale } from '../data/identity';
import { socialLinks } from '../data/site';
import { createIdentityPageSchemas } from '../lib/seo';
import { identityConnections } from '../data/identityConnections';

interface Props {
  locale: IdentityLocale;
}

const { locale } = Astro.props;
const profile = identityProfiles[locale];
const connections = identityConnections(locale);
---

<BaseLayout
  title={profile.aboutTitle}
  description={profile.aboutDescription}
  path={profile.aboutPath}
  language={profile.locale}
  alternates={identityAboutAlternates}
  schema={createIdentityPageSchemas(profile.locale, profile.aboutPath, profile.aboutTitle, profile.aboutDescription)}
>
  <article class="identity-about shell" data-locale={locale}>
    <IdentityLanguageNav currentLocale={profile.locale} page="about" />
    <header class="identity-about__header">
      <SakuraDrift variant="corner" />
      <p class="eyebrow">{profile.eyebrow}</p>
      <h1 class:list={['identity-name', { 'identity-name--ja': locale === 'ja' }]}>
        {locale === 'ja' ? <><span>Robin Xie</span><span>（謝玢）</span></> : profile.name}
      </h1>
      <p class="identity-about__native">{profile.nativeName}</p>
      <p class="identity-about__subtitle">{profile.subtitle}</p>
      <p class="identity-introduction">{connections.introduction}</p>
      <p class="identity-about__lead">{profile.aboutLead}</p>
    </header>

    <ol class="identity-axis identity-axis--about" aria-label={profile.spine}>
      {profile.axis.map((item, index) => (
        <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{item}</strong></li>
      ))}
    </ol>

    <blockquote class="identity-spine identity-spine--about">{profile.spine}</blockquote>

    <div class="identity-about__body">
      <div class="identity-about__story">
        {profile.aboutParagraphs.map((paragraph, index) => <>
          <p>{paragraph}</p>
          {connections.proofLinks[index] && <nav class="identity-proof" aria-label={connections.evidence}>
            {connections.proofLinks[index].map((link) => <a href={link.href}>{link.label}<span aria-hidden="true"> ↗</span></a>)}
          </nav>}
        </>)}
      </div>
      <aside class="identity-about__questions">
        <section>
          <p class="eyebrow">01</p>
          <h2>{profile.questionsTitle}</h2>
          <ul>{profile.questions.map((question) => <li>{question}</li>)}</ul>
        </section>
        <section>
          <p class="eyebrow">02</p>
          <h2>{profile.principlesTitle}</h2>
          <ul>{profile.principles.map((principle) => <li>{principle}</li>)}</ul>
        </section>
      </aside>
    </div>

    <section class="identity-invitation" id="work-with-robin" aria-labelledby="work-with-robin-title">
      <p class="eyebrow">{connections.areas}</p>
      <h2 id="work-with-robin-title">{connections.invitation}</h2>
      <p>{connections.context}</p>
      <a class="quiet-link" href={socialLinks.linkedin} rel="noreferrer" target="_blank">{connections.contact}<span aria-hidden="true">↗</span></a>
    </section>

    <footer class="identity-about__footer">
      <a class="quiet-link" href={profile.homePath}>{profile.homeLinkLabel}<span aria-hidden="true">←</span></a>
      <nav aria-label="Robin Xie public profiles">
        <a href={socialLinks.linkedin} rel="noreferrer" target="_blank">LinkedIn ↗</a>
        <a href={socialLinks.medium} rel="noreferrer" target="_blank">Medium ↗</a>
        <a href={socialLinks.github} rel="noreferrer" target="_blank">GitHub ↗</a>
      </nav>
    </footer>
  </article>
</BaseLayout>

<style>
  .identity-introduction { max-width: 43rem; margin-top: 1.4rem; color: var(--muted); font-size: .95rem; line-height: 1.8; }
  .identity-proof { display: flex; flex-wrap: wrap; gap: .5rem 1.4rem; margin: -.65rem 0 2rem; font-family: var(--sans); font-size: .82rem; line-height: 1.7; }
  .identity-proof a { color: var(--gold-dark); text-decoration-thickness: 1px; text-underline-offset: .25em; }
  .identity-invitation { margin-top: clamp(3rem, 6vw, 5rem); padding-top: 2rem; border-top: 1px solid var(--line); scroll-margin-top: 6rem; }
  .identity-invitation h2 { margin: .7rem 0; font-family: var(--serif); font-size: clamp(1.6rem, 3vw, 2.3rem); font-weight: 400; }
  .identity-invitation > p:not(.eyebrow) { color: var(--muted); line-height: 1.7; }
  .identity-invitation .quiet-link { margin-top: 1rem; }
</style>
