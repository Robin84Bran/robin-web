---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SeoHead from '../components/SeoHead.astro';
import type { SchemaNode } from '../lib/seo';
import '../styles/global.css';
import '../styles/zen.css';
import '../styles/identity.css';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: SchemaNode | SchemaNode[];
  language?: string;
  alternates?: Array<{ hreflang: string; path: string }>;
}

const { title, description, path, image, imageAlt, imageWidth, imageHeight, type, noindex, schema, language = 'en', alternates } = Astro.props;
---

<!doctype html>
<html lang={language}>
  <head>
    <SeoHead {title} {description} {path} {image} {imageAlt} {imageWidth} {imageHeight} {type} {noindex} {schema} {language} {alternates} />
  </head>
  <body data-path={path}>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="ambient-field" aria-hidden="true"></div>
    <SiteHeader currentPath={path} />
    <main id="content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
