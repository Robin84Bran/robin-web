{
  "name": "iamrobin-zen-loop",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "pnpm run robots:sync",
    "dev": "astro dev",
    "prebuild": "pnpm run robots:sync",
    "build": "astro build",
    "build:sites": "SITES_BUILD=1 astro build && node scripts/prepare-sites.mjs",
    "check": "astro check",
    "robots:sync": "node scripts/generate-robot-welcome.mjs",
    "robots:check": "node scripts/generate-robot-welcome.mjs --check",
    "verify:seo": "node scripts/verify-seo.mjs",
    "release:check": "pnpm run robots:check && pnpm run check && pnpm run build && pnpm run verify:seo",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@openai/sites-vite-plugin": "0.1.0"
  }
}
